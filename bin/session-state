#!/bin/sh

# Estado de la sesión de Claude Code para el panel gráfico (bin/panel). Es un
# hook de Claude Code (SessionStart, UserPromptSubmit, PostToolUse, Notification,
# Stop y SessionEnd): recibe el evento en JSON por stdin y deja el estado de la
# sesión en
#
#   ${XDG_STATE_HOME:-$HOME/.local/state}/jdev-ai/sessions/<session_id>.json
#
# Si la sesión queda esperando por una notificación, guarda también su texto en
# «message», recortado a 300 caracteres; en el resto de estados queda vacío.
#
# Además atiende dos eventos que no cambian el estado y dicen qué espera Claude
# a la persona (la transcripción no lo trae hasta que se contesta):
#
#   PreToolUse (solo AskUserQuestion)   la pregunta completa, con su tool_use_id
#   PermissionRequest (salvo AskUserQuestion, que ya registró PreToolUse)
#                                       la herramienta y su entrada
#
# Guarda el JSON del hook tal cual, de forma atómica y con un tope de 256 KiB
# (si lo pasa, no escribe), en
#
#   ${XDG_STATE_HOME:-$HOME/.local/state}/jdev-ai/prompts/<session_id>.json
#
# aparte del directorio de estados para no confundirlo con uno. Lo borran
# PostToolUse, UserPromptSubmit, Stop y SessionEnd (la herramienta terminó, la
# persona escribió, acabó el turno o la sesión). El shell no interpreta el JSON
# anidado: lo valida y lo lee el panel.
#
# Solo escribe un archivo; no necesita que el panel esté arrancado, que lo leerá
# al iniciarse. El proyecto, el agente y el worktree llegan por las variables
# JDEV_PROJECT, JDEV_SESSION_AGENT y JDEV_WORKTREE que exporta bin/agent.
#
#   session-state --hook   lee el evento de stdin y actualiza el estado.
#
# Nunca interrumpe al agente: en modo hook, ante cualquier problema termina con
# código 0 y sin salida alguna.

set -u

usage() {
    printf 'Uso: session-state --hook   (el evento del hook llega por stdin)\n' >&2
    exit 2
}

[ $# -eq 1 ] && [ "$1" = "--hook" ] || usage

exec >/dev/null 2>&1
tmp=
trap '[ -z "$tmp" ] || rm -f "$tmp"; exit 0' EXIT HUP INT TERM

# Una entrada interactiva no es un hook: no espera a que se escriba nada.
[ -t 0 ] && exit 0
input=$(cat) || exit 0
[ -n "$input" ] || exit 0

# Valor del campo de texto «$1» del objeto JSON de primer nivel, tal como viene
# escapado (listo para volver a escribirlo entre comillas). Recorre el texto
# para no confundir una clave con el contenido de otro valor; si el texto no es
# JSON bien formado hasta el campo, no imprime nada.
field() {
    printf '%s\n' "$input" | awk -v key="$1" '
        { buf = buf (NR > 1 ? " " : "") $0 }
        END {
            gsub(/[\001-\037]/, " ", buf)
            n = length(buf); depth = 0; expect = ""; curkey = ""
            for (i = 1; i <= n; i++) {
                c = substr(buf, i, 1)
                if (c == "{" || c == "[") {
                    depth++
                    if (depth == 1) expect = "key"
                } else if (c == "}" || c == "]") {
                    depth--
                } else if (depth == 1 && c == ":") {
                    expect = "value"
                } else if (depth == 1 && c == ",") {
                    expect = "key"
                } else if (c == "\"") {
                    j = i + 1
                    while (j <= n) {
                        ch = substr(buf, j, 1)
                        if (ch == "\\") {
                            nx = substr(buf, j + 1, 1)
                            if (nx == "u") {
                                if (substr(buf, j + 2, 4) !~ /^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$/) exit
                                j += 6
                            } else if (nx != "" && index("\"\\/bfnrt", nx) > 0) {
                                j += 2
                            } else exit
                        } else if (ch == "\"") {
                            break
                        } else {
                            j++
                        }
                    }
                    if (j > n) exit
                    if (depth == 1) {
                        s = substr(buf, i + 1, j - i - 1)
                        if (expect == "key") {
                            curkey = s
                        } else if (expect == "value") {
                            if (curkey == key) { print s; exit }
                            expect = ""
                        }
                    }
                    i = j
                }
            }
        }
    '
}

# Escapa un valor del entorno como cadena JSON.
json_string() {
    printf '%s' "$1" | awk '
        BEGIN { ORS = ""; print "\"" }
        {
            gsub(/\\/, "\\\\")
            gsub(/"/, "\\\"")
            gsub(/[\001-\037]/, " ")
            if (NR > 1) print " "
            print
        }
        END { print "\"" }
    '
}

# Recorta a $1 caracteres un valor ya escapado como cadena JSON sin partir una
# secuencia de escape, un carácter UTF-8 ni un par sustituto \uXXXX; si recorta,
# termina en «…». Trabaja por bytes (LC_ALL=C) para contar los caracteres
# multibyte como uno solo.
truncate_json() {
    printf '%s' "$2" | LC_ALL=C awk -v max="$1" '
        { buf = buf $0 }
        END {
            n = length(buf); i = 1; count = 0; out = ""
            while (i <= n) {
                c = substr(buf, i, 1)
                if (c == "\\") {
                    if (substr(buf, i + 1, 1) == "u") {
                        len = 6
                        if (substr(buf, i + 2, 4) ~ /^[dD][89abAB]/ && substr(buf, i + 6, 2) == "\\u" && substr(buf, i + 8, 4) ~ /^[dD][c-fC-F]/) len = 12
                    } else len = 2
                } else if (c ~ /[\300-\367]/) {
                    len = 1
                    while (substr(buf, i + len, 1) ~ /[\200-\277]/) len++
                } else len = 1
                if (count == max - 1 && i + len <= n) { out = out "\342\200\246"; break }
                out = out substr(buf, i, len); count++; i += len
            }
            printf "%s", out
        }
    '
}

# Correspondencia evento -> estado: deja el resultado en new_state y devuelve 1
# si el evento no cambia el estado (evento desconocido o Notification ajena).
# Es lo más frágil del script, porque depende de cómo avisa Claude Code: usa
# notification_type si llega y, si no, el texto del mensaje.
#   $1 evento, $2 notification_type, $3 message
map_state() {
    case "$1" in
        SessionStart|Stop) new_state=idle ;;
        UserPromptSubmit|PostToolUse) new_state=working ;;
        SessionEnd) new_state=ended ;;
        Notification)
            if [ -n "$2" ]; then
                case "$2" in
                    permission_prompt|elicitation_dialog) new_state=waiting ;;
                    idle_prompt) new_state=idle ;;
                    *) return 1 ;;
                esac
            else
                lowered=$(printf '%s' "$3" | tr '[:upper:]' '[:lower:]')
                case "$lowered" in
                    *permission*|*"needs your"*) new_state=waiting ;;
                    *"waiting for your input"*) new_state=idle ;;
                    *) return 1 ;;
                esac
            fi
            ;;
        *) return 1 ;;
    esac
}

# Guarda el evento del hook (PreToolUse de AskUserQuestion o PermissionRequest de
# otra herramienta) como lo pendiente de la sesión. Sin salida de error: ante
# cualquier problema no escribe nada.
save_prompt() {
    tool=$(field tool_name)
    case "$event:$tool" in
        PreToolUse:AskUserQuestion) ;;
        PermissionRequest:AskUserQuestion|PermissionRequest:) return 0 ;;
        PermissionRequest:*) ;;
        *) return 0 ;;
    esac
    size=$(printf '%s' "$input" | wc -c | tr -d ' ')
    [ "$size" -le 262144 ] || return 0
    mkdir -p -- "$prompts_dir" || return 0
    tmp=$(mktemp "$prompts_dir/.$session_id.XXXXXX") || return 0
    printf '%s\n' "$input" > "$tmp" || return 0
    mv -f -- "$tmp" "$prompts_dir/$session_id.json" && tmp=
}

session_id=$(field session_id)
case "$session_id" in
    ""|*[!A-Za-z0-9-]*) exit 0 ;;
esac

state_root=${XDG_STATE_HOME:-${HOME:-}/.local/state}
[ -n "$state_root" ] && [ "$state_root" != "/.local/state" ] || exit 0
prompts_dir="$state_root/jdev-ai/prompts"

event=$(field hook_event_name)
# Lo pendiente no toca el estado: se guarda o se borra y no se sigue.
case "$event" in
    PreToolUse|PermissionRequest) save_prompt; exit 0 ;;
    PostToolUse|UserPromptSubmit|Stop|SessionEnd) rm -f -- "$prompts_dir/$session_id.json" ;;
esac

message=$(field message)
map_state "$event" "$(field notification_type)" "$message" || exit 0
# El texto del aviso solo tiene sentido mientras la sesión espera a la persona.
if [ "$new_state" = waiting ]; then
    message=$(truncate_json 300 "$message")
else
    message=
fi

dir="$state_root/jdev-ai/sessions"
mkdir -p -- "$dir" || exit 0

tmux_session=
if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    tmux_session=$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#S' 2>/dev/null | head -n 1) || tmux_session=
fi

# El temporal vive en el mismo directorio para que mv sea una renombración
# atómica; el punto inicial evita que se lea como una sesión.
tmp=$(mktemp "$dir/.$session_id.XXXXXX") || exit 0
{
    printf '{"session_id":"%s",' "$session_id"
    printf '"state":"%s",' "$new_state"
    printf '"event":"%s",' "$event"
    printf '"updated_at":"%s",' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '"project":%s,' "$(json_string "${JDEV_PROJECT:-}")"
    printf '"agent":%s,' "$(json_string "${JDEV_SESSION_AGENT:-}")"
    printf '"worktree":%s,' "$(json_string "${JDEV_WORKTREE:-}")"
    printf '"transcript_path":"%s",' "$(field transcript_path)"
    printf '"cwd":"%s",' "$(field cwd)"
    printf '"tmux_session":%s,' "$(json_string "$tmux_session")"
    printf '"message":"%s"}\n' "$message"
} > "$tmp" || exit 0
mv -f -- "$tmp" "$dir/$session_id.json" && tmp=
exit 0
