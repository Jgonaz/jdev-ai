#!/bin/sh

set -eu

usage() {
    cat <<'EOF'
Uso: agent <proyecto|.> [--codex|--claude|--copilot|--opencode]

Abre un repositorio de jdev-ai/projects/ con Codex (por defecto) o con
el agente indicado. Usa «agent .» desde un repositorio Git situado dentro
de projects/.

Codex usa por defecto Sol/medium como orquestador y un único implementador
Luna/max definido por el harness. Puedes sobrescribirlos con las variables
JDEV_CODEX_ORCHESTRATOR_MODEL, JDEV_CODEX_ORCHESTRATOR_EFFORT,
JDEV_CODEX_IMPLEMENTER_MODEL y JDEV_CODEX_IMPLEMENTER_EFFORT.
EOF
}

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

validate_codex_model() {
    case "$2" in
        ""|*[!A-Za-z0-9._:/-]*) fail "$1 contiene un modelo no válido: $2" ;;
    esac
}

validate_codex_effort() {
    case "$2" in
        none|low|medium|high|xhigh|max) ;;
        *) fail "$1 debe ser none, low, medium, high, xhigh o max: $2" ;;
    esac
}

history_continuation() {
    awk '
        /^## Continuación recomendada$/ { section = 1; next }
        section && /^## / { exit }
        section && /^- / {
            sub(/^- /, "")
            text = $0
            collecting = 1
            next
        }
        section && collecting && /^  / {
            sub(/^  /, "")
            text = text " " $0
            next
        }
        section && collecting { exit }
        END { print text }
    ' "$1"
}

if [ "$#" -eq 0 ]; then
    usage
    exit 0
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

project=$1
shift
agent_command=codex

if [ "$#" -gt 1 ]; then
    fail "demasiados argumentos"
fi

if [ "$#" -eq 1 ]; then
    case "$1" in
        --codex) agent_command=codex ;;
        --claude) agent_command=claude ;;
        --copilot) agent_command=copilot ;;
        --opencode) agent_command=opencode ;;
        -h|--help)
            usage
            exit 0
            ;;
        *) fail "agente desconocido: $1" ;;
    esac
fi

if [ "$agent_command" = "codex" ]; then
    codex_orchestrator_model=${JDEV_CODEX_ORCHESTRATOR_MODEL:-gpt-5.6-sol}
    codex_orchestrator_effort=${JDEV_CODEX_ORCHESTRATOR_EFFORT:-medium}
    codex_implementer_model=${JDEV_CODEX_IMPLEMENTER_MODEL:-gpt-5.6-luna}
    codex_implementer_effort=${JDEV_CODEX_IMPLEMENTER_EFFORT:-max}

    validate_codex_model JDEV_CODEX_ORCHESTRATOR_MODEL "$codex_orchestrator_model"
    validate_codex_effort JDEV_CODEX_ORCHESTRATOR_EFFORT "$codex_orchestrator_effort"
    validate_codex_model JDEV_CODEX_IMPLEMENTER_MODEL "$codex_implementer_model"
    validate_codex_effort JDEV_CODEX_IMPLEMENTER_EFFORT "$codex_implementer_effort"
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
harness_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
projects_root="$harness_root/projects"
codex_implementer_config="$harness_root/adapters/codex/implementer.toml"

if [ "$project" = "." ]; then
    command -v git >/dev/null 2>&1 || fail "Git no está instalado o no está disponible en PATH"
    project_dir=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || \
        fail "el directorio actual no pertenece a un repositorio Git"
    project_dir=$(CDPATH= cd -- "$project_dir" && pwd -P)

    case "$project_dir/" in
        "$projects_root/"*) ;;
        *) fail "el repositorio actual no está dentro de $projects_root" ;;
    esac
else
    case "$project" in
        ""|/*|.|..|*/*) fail "indica un nombre de proyecto directo dentro de projects/" ;;
    esac

    candidate="$projects_root/$project"
    [ -d "$candidate" ] || fail "el proyecto no existe: $candidate"
    project_dir=$(CDPATH= cd -- "$candidate" && pwd -P)

    case "$project_dir/" in
        "$projects_root/"*) ;;
        *) fail "el proyecto resuelto no está dentro de $projects_root" ;;
    esac
fi

command -v git >/dev/null 2>&1 || fail "Git no está instalado o no está disponible en PATH"
repo_root=$(git -C "$project_dir" rev-parse --show-toplevel 2>/dev/null) || \
    fail "el proyecto no parece un repositorio Git válido: $project_dir"
repo_root=$(CDPATH= cd -- "$repo_root" && pwd -P)
[ "$repo_root" = "$project_dir" ] || \
    fail "el directorio seleccionado no es la raíz de su repositorio Git: $project_dir"

command -v "$agent_command" >/dev/null 2>&1 || \
    fail "el ejecutable '$agent_command' no está instalado o no está disponible en PATH"

if [ "$agent_command" = "codex" ]; then
    [ -f "$codex_implementer_config" ] || \
        fail "no se encuentra el adaptador del implementador: $codex_implementer_config"
fi

cd -- "$project_dir"

project_name=${project_dir##*/}
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse --short HEAD)

if [ -n "$(git status --porcelain)" ]; then
    git_state="cambios locales"
else
    git_state="limpio"
fi

active_changes=
if [ -d "$project_dir/openspec/changes" ]; then
    for change_dir in "$project_dir"/openspec/changes/*; do
        [ -d "$change_dir" ] || continue
        change_name=${change_dir##*/}
        [ "$change_name" = "archive" ] && continue

        if [ -z "$active_changes" ]; then
            active_changes=$change_name
        else
            active_changes="$active_changes, $change_name"
        fi
    done
fi

if [ -n "$active_changes" ]; then
    openspec_state=$active_changes
else
    openspec_state="sin cambios activos"
fi

latest_history=
history_dir="$project_dir/.agent/history"
if [ -d "$history_dir" ]; then
    for history_file in "$history_dir"/*.md; do
        [ -f "$history_file" ] || continue
        latest_history=$history_file
    done
fi

history_date=
history_status=
history_title=
history_next=

if [ -n "$latest_history" ]; then
    history_title=$(sed -n '1{s/^# //;p;}' "$latest_history")
    history_date=$(sed -n 's/^Fecha: //p' "$latest_history")
    history_status=$(sed -n 's/^Estado: //p' "$latest_history")
    history_next=$(history_continuation "$latest_history")

    [ -n "$history_title" ] || history_title=${latest_history##*/}
    [ -n "$history_date" ] || history_date="fecha desconocida"
    [ -n "$history_status" ] || history_status="estado desconocido"
fi

if [ "$history_status" = "bloqueada" ]; then
    session_mode="BLOCKED"
elif [ "$git_state" = "cambios locales" ]; then
    session_mode="REVIEW"
elif [ -n "$active_changes" ] || [ "$history_status" = "en curso" ]; then
    session_mode="CONTINUE"
elif [ -n "$latest_history" ]; then
    session_mode="READY"
else
    session_mode="NEW"
fi

if [ "$git_state" = "cambios locales" ] && [ -n "$active_changes" ]; then
    current_signal="Hay cambios locales y OpenSpec activo: $active_changes."
elif [ "$git_state" = "cambios locales" ]; then
    current_signal="Hay cambios locales sin commit."
elif [ -n "$active_changes" ]; then
    current_signal="OpenSpec activo: $active_changes."
else
    current_signal="Sin trabajo técnico pendiente detectado."
fi

if [ -z "$history_next" ]; then
    if [ "$git_state" = "cambios locales" ]; then
        history_next="Revisa los cambios locales antes de iniciar otra tarea."
    elif [ -n "$active_changes" ]; then
        history_next="Continúa el cambio OpenSpec activo."
    else
        history_next="Describe una tarea nueva o pide al agente que proponga el siguiente paso."
    fi
fi

printf '\n%s\n' '+------------------------------------------------------------+'
printf '%s\n' '| JDEV-AI // AGENT SESSION                                  |'
printf '%s\n' '+------------------------------------------------------------+'
printf '  project   : %s\n' "$project_name"
printf '  agent     : %s\n' "$agent_command"
if [ "$agent_command" = "codex" ]; then
    printf '  orchestr. : %s [%s]\n' "$codex_orchestrator_model" "$codex_orchestrator_effort"
    printf '  implement.: %s [%s]\n' "$codex_implementer_model" "$codex_implementer_effort"
fi
printf '  branch    : %s\n' "$branch"
printf '  git       : %s\n' "$git_state"
printf '  openspec  : %s\n' "$openspec_state"
printf '  mode      : %s\n' "$session_mode"

if [ -n "$latest_history" ]; then
    printf '  history   : %s [%s]\n' "$history_date" "$history_status"
    printf '  last      : %s\n' "$history_title"
else
    printf '  history   : sin entradas\n'
fi

printf '%s\n' '+------------------------------------------------------------+'
printf '  signal    : %s\n' "$current_signal"
printf '  next      : %s\n' "$history_next"
printf '%s\n\n' '+------------------------------------------------------------+'

if [ "$agent_command" = "codex" ]; then
    exec "$agent_command" \
        --model "$codex_orchestrator_model" \
        --config "model_reasoning_effort=\"$codex_orchestrator_effort\"" \
        --config 'agents.enabled=true' \
        --config 'agents.max_concurrent_threads_per_session=1' \
        --config "agents.default_subagent_model=\"$codex_implementer_model\"" \
        --config "agents.default_subagent_reasoning_effort=\"$codex_implementer_effort\"" \
        --config 'agents.implementer.description="Implementa tareas planificadas, concretas y delimitadas por el orquestador."' \
        --config "agents.implementer.config_file=\"$codex_implementer_config\""
fi

exec "$agent_command"
