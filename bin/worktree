#!/bin/sh

set -eu

usage() {
    cat <<'EOF'
Uso: worktree <create|list|push|merge|remove> [feature] [--local]

Gestiona los worktrees de feature de un proyecto de jdev-ai/projects/. Se
ejecuta desde el checkout principal del proyecto o desde cualquiera de sus
worktrees. Cada feature tiene la rama feat/<feature> y el worktree
projects/<proyecto>.worktrees/<feature>/.

  create <feature>   Crea o reutiliza la rama y el worktree (idempotente) y
                     copia los archivos de .agent/worktree-files sin
                     sobrescribir nada. Imprime la ruta del worktree en stdout;
                     los mensajes informativos van a stderr.
  list               Muestra los worktrees del proyecto y si tienen cambios.
  push <feature>     Sube feat/<feature> a «origin» (git push -u) como copia de
                     seguridad durante el trabajo. Exige el worktree existente.
  merge <feature>    Integra feat/<feature> en la rama del checkout principal.
                     Exige el worktree limpio. Tiene dos modos:
                     - Por defecto, si el checkout principal tiene «origin»:
                       modo Pull Request. Sube la rama, exige una PR abierta
                       contra la rama del principal (la crea antes el agente con
                       «gh pr create --base <destino> --head feat/<feature>
                       --title ... --body ...»), espera sus checks, la integra
                       con «gh pr merge --merge», borra la rama remota y
                       actualiza el principal con fetch + merge --ff-only. Si
                       no puede actualizarlo avisa, pero termina con código 0
                       porque la PR ya está integrada. Requiere «gh».
                     - Con --local (en cualquier posición), o automáticamente si
                       no hay «origin»: merge --no-ff en el principal; ante un
                       conflicto aborta y lo deja como estaba.
  remove <feature>   Elimina el worktree sin forzar y borra la rama solo si
                     está integrada. No se puede ejecutar desde dentro de él.

El nombre de la feature solo admite [a-z0-9._-], sin empezar por «.» o «-» y
sin «..».

Variable de entorno: JDEV_WORKTREE_CHECKS_WAIT (segundos, por defecto 10) es la
espera entre los reintentos cuando la PR aún no tiene checks registrados.
EOF
}

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

# Los mensajes informativos van a stderr para que stdout quede reservado a la
# ruta que captura bin/agent.
info() {
    printf '%s\n' "$1" >&2
}

validate_feature() {
    case "$1" in
        "") fail "indica el nombre de la feature" ;;
        .*|-*) fail "el nombre de la feature no puede empezar por «.» ni por «-»: $1" ;;
        *..*) fail "el nombre de la feature no puede contener «..»: $1" ;;
        *[!a-z0-9._-]*) fail "el nombre de la feature solo admite [a-z0-9._-]: $1" ;;
    esac
    # Descarta nombres que Git no admite como rama (por ejemplo, «x.lock»).
    git check-ref-format --branch "feat/$1" >/dev/null 2>&1 || \
        fail "el nombre de la feature no es válido como rama de Git: $1"
}

if [ "$#" -eq 0 ]; then
    usage
    exit 0
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
esac

command_name=$1
shift
feature=

local_mode=0
case "$command_name" in
    merge)
        # «--local» se admite antes o después de la feature.
        for arg in "$@"; do
            case "$arg" in
                --local) local_mode=1 ;;
                *)
                    [ -z "$feature" ] || fail "demasiados argumentos: $arg"
                    feature=$arg
                    ;;
            esac
        done
        [ -n "$feature" ] || fail "indica la feature: worktree merge <feature> [--local]"
        ;;
    create|push|remove)
        [ "$#" -ge 1 ] || fail "indica la feature: worktree $command_name <feature>"
        [ "$#" -le 1 ] || fail "demasiados argumentos: $2"
        feature=$1
        ;;
    list)
        [ "$#" -eq 0 ] || fail "«list» no admite argumentos: $1"
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *) fail "comando desconocido: $command_name (usa create, list, push, merge o remove)" ;;
esac

command -v git >/dev/null 2>&1 || fail "Git no está instalado o no está disponible en PATH"
[ -z "$feature" ] || validate_feature "$feature"

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
harness_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
projects_root="$harness_root/projects"

# El checkout principal es el padre del .git común, tanto si se ejecuta desde él
# como desde uno de sus worktrees.
common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || \
    fail "el directorio actual no pertenece a un repositorio Git"
common_dir=$(CDPATH= cd -- "$common_dir" && pwd -P)
[ "${common_dir##*/}" = ".git" ] || \
    fail "el repositorio actual no tiene un checkout principal con .git"
main_checkout=${common_dir%/*}

[ "$main_checkout" != "$harness_root" ] || \
    fail "el harness no admite worktrees; usa un proyecto de $projects_root"
[ "${main_checkout%/*}" = "$projects_root" ] || \
    fail "el repositorio actual no es un proyecto directo de $projects_root"

project_name=${main_checkout##*/}
worktrees_root="$projects_root/$project_name.worktrees"
branch="feat/$feature"
worktree_path="$worktrees_root/$feature"

git_main() {
    git -C "$main_checkout" "$@"
}

# Ruta donde está desprotegida la rama «feat/<feature>», o nada si no lo está.
branch_worktree() {
    git_main worktree list --porcelain | awk -v ref="branch refs/heads/$branch" '
        /^worktree / { path = substr($0, 10) }
        $0 == ref { print path; exit }
    '
}

# Pares «ruta<TAB>rama» de los worktrees que no son el checkout principal.
other_worktrees() {
    git_main worktree list --porcelain | awk '
        function flush() {
            if (path != "" && n > 1) print path "\t" (branch == "" ? "(detached)" : branch)
        }
        /^worktree / { flush(); n++; path = substr($0, 10); branch = ""; next }
        /^branch / { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
        END { flush() }
    '
}

main_ref_description() {
    if ref=$(git_main symbolic-ref --quiet --short HEAD 2>/dev/null); then
        printf '%s' "$ref"
    else
        printf 'commit %s (HEAD desprotegido)' "$(git_main rev-parse --short HEAD)"
    fi
}

copy_worktree_files() {
    list_file="$main_checkout/.agent/worktree-files"
    [ -f "$list_file" ] || return 0

    copied=0
    while IFS= read -r line || [ -n "$line" ]; do
        entry=$(printf '%s' "$line" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        case "$entry" in
            ""|"#"*) continue ;;
            /*|*..*)
                info "Aviso: se omite la ruta no permitida en worktree-files: $entry"
                continue
                ;;
        esac
        while [ "${entry%/}" != "$entry" ]; do entry=${entry%/}; done
        [ -n "$entry" ] || continue

        source_path="$main_checkout/$entry"
        target_path="$worktree_path/$entry"
        [ -e "$source_path" ] || [ -L "$source_path" ] || continue
        # Nunca se sobrescribe: lo que ya existe en el worktree manda.
        if [ -e "$target_path" ] || [ -L "$target_path" ]; then
            continue
        fi

        mkdir -p -- "$(dirname -- "$target_path")"
        if [ -d "$source_path" ] && [ ! -L "$source_path" ]; then
            cp -Rp -- "$source_path" "$target_path"
        else
            cp -p -- "$source_path" "$target_path"
        fi
        info "Copiado al worktree: $entry"
        copied=$((copied + 1))
    done < "$list_file"

    [ "$copied" -gt 0 ] || info "No hay archivos de .agent/worktree-files que copiar."
}

cmd_create() {
    git_main rev-parse --verify --quiet HEAD >/dev/null || \
        fail "el checkout principal no tiene ningún commit: $main_checkout"

    existing=$(branch_worktree)
    if [ -n "$existing" ]; then
        if [ "$existing" = "$worktree_path" ] && [ -d "$worktree_path" ]; then
            info "Worktree existente: $worktree_path ($branch)"
        else
            fail "la rama $branch ya está desprotegida en otra ruta: $existing"
        fi
    else
        if [ -e "$worktree_path" ] || [ -L "$worktree_path" ]; then
            fail "la ruta $worktree_path ya existe y no es el worktree de $branch"
        fi

        if git_main show-ref --verify --quiet "refs/heads/$branch"; then
            git_main worktree add -- "$worktree_path" "$branch" >&2 || \
                fail "no se pudo crear el worktree de la rama existente $branch"
            info "Worktree creado en $worktree_path con la rama existente $branch."
        else
            base=$(main_ref_description)
            git_main worktree add -b "$branch" -- "$worktree_path" HEAD >&2 || \
                fail "no se pudo crear la rama $branch y su worktree"
            info "Rama $branch creada desde $base; worktree en $worktree_path."
        fi
    fi

    copy_worktree_files
    printf '%s\n' "$worktree_path"
}

cmd_list() {
    entries=$(other_worktrees)
    if [ -z "$entries" ]; then
        printf 'No hay worktrees abiertos en %s.\n' "$project_name"
        return 0
    fi

    printf 'Worktrees de %s:\n' "$project_name"
    printf '%s\n' "$entries" | while IFS="$(printf '\t')" read -r path wt_branch; do
        case "$path" in
            "$worktrees_root/"*) name=${path#"$worktrees_root/"} ;;
            *) name=$path ;;
        esac
        if [ ! -d "$path" ]; then
            state="directorio ausente"
        elif [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
            state="con cambios"
        else
            state="limpio"
        fi
        printf '  %-24s %-28s %s\n' "$name" "$wt_branch" "$state"
    done
}

require_worktree() {
    existing=$(branch_worktree)
    [ "$existing" = "$worktree_path" ] && [ -d "$worktree_path" ] || \
        fail "no existe el worktree de $branch en $worktree_path"
}

cmd_push() {
    require_worktree
    git_main remote get-url origin >/dev/null 2>&1 || \
        fail "el checkout principal no tiene remoto «origin»; no hay dónde subir $branch"

    info "Subiendo $branch a origin."
    git -C "$worktree_path" push -u origin "$branch" >&2 || \
        fail "no se pudo subir $branch a origin"
    info "Rama $branch subida a origin."
}

cmd_merge() {
    require_worktree

    [ -z "$(git -C "$worktree_path" status --porcelain)" ] || \
        fail "el worktree tiene cambios sin confirmar; haz commit antes de integrar: $worktree_path"
    if git_main rev-parse --verify --quiet MERGE_HEAD >/dev/null; then
        fail "el checkout principal tiene un merge en curso; termínalo o abórtalo antes: $main_checkout"
    fi

    if [ "$local_mode" -eq 1 ]; then
        merge_local
    elif git_main remote get-url origin >/dev/null 2>&1; then
        merge_pr
    else
        info "Aviso: el checkout principal no tiene remoto «origin»; se integra en local (como con --local)."
        merge_local
    fi
}

merge_local() {
    target=$(main_ref_description)
    info "Integrando $branch en $target (checkout principal: $main_checkout)."
    if git_main merge --no-ff --no-edit "$branch"; then
        info "Integración completada. Para limpiar: worktree remove $feature"
        return 0
    fi

    # Si el merge llegó a empezar hay que abortarlo; si un cambio local lo
    # bloqueó antes, no hay nada que deshacer.
    if git_main rev-parse --verify --quiet MERGE_HEAD >/dev/null; then
        git_main merge --abort
    fi
    fail "no se pudo integrar $branch en $target y el checkout principal ha quedado como estaba.
Integra $target en el worktree (cd $worktree_path && git merge $target), resuelve allí los conflictos, repite las validaciones y vuelve a ejecutar «worktree merge $feature».
Si el fallo se debe a cambios locales en el checkout principal, confírmalos o guárdalos antes."
}

# gh se ejecuta desde el worktree: allí la rama está desprotegida y el
# repositorio se resuelve igual que desde el principal.
gh_run() {
    (cd "$worktree_path" && gh "$@")
}

# Espera los checks de la PR. Un «no checks reported» inmediato suele ser solo
# que aún no se han registrado, así que se reintenta unas veces antes de
# continuar sin ellos. La espera entre reintentos (segundos, por defecto 10) se
# puede acortar con JDEV_WORKTREE_CHECKS_WAIT, por ejemplo en las pruebas.
wait_pr_checks() {
    wait_seconds=${JDEV_WORKTREE_CHECKS_WAIT:-10}
    case "$wait_seconds" in
        ""|*[!0-9]*) fail "JDEV_WORKTREE_CHECKS_WAIT debe ser un número de segundos: $wait_seconds" ;;
    esac

    checks_log=$(mktemp)
    checks_rc=$(mktemp)
    retries=0
    while :; do
        info "Esperando los checks de la PR #$pr_number."
        # El código de gh se guarda aparte porque la tubería (tee, para ver el
        # avance en directo y poder buscar «no checks reported») lo pierde.
        { gh_run pr checks "$pr_number" --watch --fail-fast && echo 0 > "$checks_rc" || echo "$?" > "$checks_rc"; } 2>&1 | tee "$checks_log" >&2
        rc=$(cat "$checks_rc")
        if [ "$rc" = 0 ]; then
            info "Los checks de la PR #$pr_number han pasado."
            return 0
        fi
        if grep -qi 'no checks reported' "$checks_log"; then
            if [ "$retries" -lt 3 ]; then
                retries=$((retries + 1))
                info "La PR #$pr_number aún no tiene checks registrados; reintento $retries/3 en ${wait_seconds} s."
                sleep "$wait_seconds"
                continue
            fi
            info "Aviso: la PR #$pr_number no tiene checks; se continúa sin ellos."
            return 0
        fi
        fail "los checks de la PR #$pr_number no han pasado (o no han terminado); no se integra nada.
Corrige el problema en el worktree ($worktree_path), haz commit y vuelve a ejecutar «worktree merge $feature»: la rama se sube de nuevo y la PR se actualiza."
    done
}

merge_pr() {
    target=$(git_main symbolic-ref --quiet --short HEAD 2>/dev/null) || \
        fail "el checkout principal tiene HEAD desprotegido; sitúalo en la rama destino o usa «worktree merge $feature --local»"
    command -v gh >/dev/null 2>&1 || \
        fail "falta «gh» (GitHub CLI) en PATH; instálalo o integra sin Pull Request con «worktree merge $feature --local»"

    gh_log=
    checks_log=
    checks_rc=
    trap 'rm -f "$gh_log" "$checks_log" "$checks_rc"' EXIT
    gh_log=$(mktemp)

    info "Subiendo $branch a origin."
    git -C "$worktree_path" push -u origin "$branch" >&2 || \
        fail "no se pudo subir $branch a origin"

    no_pr_message="no hay una Pull Request abierta de $branch contra $target.
Créala antes con: gh pr create --base $target --head $branch --title \"...\" --body \"...\"
y vuelve a ejecutar «worktree merge $feature»."
    pr_info=$(gh_run pr view "$branch" --json number,state,baseRefName -q '"\(.number) \(.state) \(.baseRefName)"' 2> "$gh_log") || \
        fail "$no_pr_message
(gh: $(tr '\n' ' ' < "$gh_log"))"
    read -r pr_number pr_state pr_base <<EOF
$pr_info
EOF
    case "$pr_number" in
        ""|*[!0-9]*) fail "gh devolvió datos de PR inesperados: $pr_info" ;;
    esac
    [ "$pr_state" = "OPEN" ] || fail "$no_pr_message
(la PR #$pr_number está en estado $pr_state)"
    [ "$pr_base" = "$target" ] || \
        fail "la PR #$pr_number tiene como base $pr_base y la rama destino es $target; ajusta su base (gh pr edit $pr_number --base $target) o cámbiala de rama."

    wait_pr_checks

    info "Integrando la PR #$pr_number en $target (merge commit)."
    # Sin --delete-branch: gh intentaría borrar también la rama local, que está
    # desprotegida en el worktree. La remota se borra después.
    gh_run pr merge "$pr_number" --merge >&2 || \
        fail "gh no pudo integrar la PR #$pr_number (conflictos, protección de rama o requisitos pendientes).
Integra $target en el worktree (cd $worktree_path && git fetch origin && git merge origin/$target), resuelve allí los conflictos, repite las validaciones, haz commit y vuelve a ejecutar «worktree merge $feature»."
    info "PR #$pr_number integrada en $target."

    git_main push origin --delete "$branch" >&2 || \
        info "Aviso: no se pudo borrar $branch de origin (quizá GitHub ya la borró)."

    # El principal no se fuerza: con commits locales sin subir o cambios que
    # chocan, el ff falla y se deja a la persona decidir cómo ponerlo al día.
    if git_main fetch origin "$target" >&2 && git_main merge --ff-only "origin/$target" >&2; then
        info "Checkout principal actualizado con origin/$target."
        info "Integración completada. Para limpiar: worktree remove $feature"
        return 0
    fi

    # Se sale con 0: la integración (lo que pide este comando) ya está hecha y
    # un código distinto de cero invitaría a repetirla, cuando la PR ya no está
    # abierta. El aviso va en stderr y deja la rama local sin borrar en remove.
    info "AVISO: la PR #$pr_number ya está integrada en GitHub, pero no se ha podido actualizar el checkout principal con origin/$target (¿commits locales sin subir o cambios locales que chocan?)."
    info "Actualízalo a mano en $main_checkout (por ejemplo «git pull» o «git merge origin/$target») y después ejecuta: worktree remove $feature"
}

cmd_remove() {
    require_worktree

    current_dir=$(pwd -P)
    case "$current_dir/" in
        "$worktree_path/"*) fail "no se puede eliminar el worktree desde dentro de él; ejecuta el comando desde el checkout principal" ;;
    esac

    git_main worktree remove -- "$worktree_path" >&2 || \
        fail "no se pudo eliminar el worktree (¿tiene cambios sin confirmar?): $worktree_path"
    # El directorio contenedor sobra cuando se elimina el último worktree.
    rmdir "$worktrees_root" 2>/dev/null || true
    info "Worktree eliminado: $worktree_path"

    if git_main branch -d "$branch" >&2 2>&1; then
        info "Rama $branch eliminada."
    else
        info "Aviso: la rama $branch no está integrada y se conserva; intégrala o bórrala a mano con «git branch -D $branch»."
    fi
}

case "$command_name" in
    create) cmd_create ;;
    list) cmd_list ;;
    push) cmd_push ;;
    merge) cmd_merge ;;
    remove) cmd_remove ;;
esac
