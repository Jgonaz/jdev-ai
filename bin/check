#!/bin/sh

# Validación del harness: comprueba bin/agent sobre un harness temporal con
# agentes simulados, sin lanzar ningún agente real ni tocar projects/.

set -eu

# Si bin/check se lanza desde una sesión abierta con bin/agent, hereda las
# variables del panel y alteran la salida que se comprueba.
unset JDEV_SESSION_AGENT JDEV_SESSION_ORCHESTRATOR JDEV_SESSION_IMPLEMENTER JDEV_SESSION_WARNING JDEV_MAIN_CHECKOUT JDEV_WORKTREE

harness_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM

failures=0
pass() { printf 'ok   %s\n' "$1"; }
fail() { printf 'FAIL %s\n' "$1"; failures=$((failures + 1)); }
check() {
    if eval "$2"; then pass "$1"; else fail "$1"; fi
}

# Harness temporal con un proyecto de prueba y su historial.
mkdir -p "$work/h/bin" "$work/h/adapters/codex" "$work/h/adapters/claude" "$work/h/projects/demo/.agent/history" "$work/bin"
cp "$harness_root/bin/agent" "$harness_root/bin/session-status" "$harness_root/bin/subagent-notice" "$harness_root/bin/worktree" "$work/h/bin/"
cp "$harness_root/AGENTS.md" "$work/h/AGENTS.md"
cp "$harness_root/adapters/codex/implementer.toml" "$work/h/adapters/codex/"
cp "$harness_root/adapters/claude/agents.json" "$work/h/adapters/claude/"
git init -q "$work/h"
git init -q "$work/h/projects/demo"
cat > "$work/h/projects/demo/.agent/history/2026-01-01-1000-prueba.md" <<'EOF'
# Prueba

Fecha: 2026-01-01 10:00
Estado: en curso

## Resumen

- Primer punto
  en dos líneas.
- Segundo punto.
- Tercer punto.

## Pendiente de ti

- Decidir el nombre
  definitivo.

## Continuación recomendada

- Primera acción
  en dos líneas.
- Segunda.
EOF
# Entrada anterior del mismo día sin hora: ordenada por nombre quedaría delante.
printf '# Antigua\n\nFecha: 2026-01-01\nEstado: finalizada\n' > "$work/h/projects/demo/.agent/history/2026-01-01-sin-hora.md"
touch -d '2026-01-01 09:00' "$work/h/projects/demo/.agent/history/2026-01-01-sin-hora.md"
mkdir -p "$work/h/projects/demo/openspec/changes/cambio-x" "$work/h/projects/demo/openspec/changes/archive/viejo"
printf -- '- [x] Hecha\n- [ ] Pendiente\n  - [ ] Subtarea\n' > "$work/h/projects/demo/openspec/changes/cambio-x/tasks.md"

# Agentes simulados: guardan sus argumentos separados por NUL, seguidos del
# aviso que el launcher exporta para el panel, además del directorio de
# lanzamiento (.cwd) y las variables de worktree (.env).
verified=$(sed -n 's/^codex_verified_version=//p' "$harness_root/bin/agent")
for name in codex claude copilot; do
    cat > "$work/bin/$name" <<EOF
#!/bin/sh
[ "\${1:-}" = "--version" ] && { echo "codex-cli \${FAKE_CODEX_VERSION:-$verified}"; exit 0; }
pwd -P > "$work/$name.cwd"
printf '%s\\n%s\\n' "\${JDEV_MAIN_CHECKOUT:-}" "\${JDEV_WORKTREE:-}" > "$work/$name.env"
for x in "\$@" "JDEV_SESSION_WARNING=\${JDEV_SESSION_WARNING:-}"; do printf '%s\\0' "\$x"; done > "$work/$name.args"
EOF
    chmod +x "$work/bin/$name"
done

agent="$work/h/bin/agent"
status="$work/h/bin/session-status"
run() { rm -f "$work"/*.args "$work"/*.cwd "$work"/*.env; PATH="$work/bin:$PATH" "$agent" "$@" > "$work/out" 2>&1; }
args() { tr '\0' '\n' < "$work/$1.args"; }

check "sintaxis de bin/agent" 'sh -n "$harness_root/bin/agent"'
check "sintaxis de bin/session-status" 'sh -n "$harness_root/bin/session-status"'
check "sintaxis de bin/subagent-notice" 'sh -n "$harness_root/bin/subagent-notice"'
check "sin argumentos muestra la ayuda" 'run && grep -q "^Uso:" "$work/out"'

check "claude por defecto" 'run demo && [ -f "$work/claude.args" ] && [ ! -f "$work/codex.args" ]'
check "agente antes del proyecto" 'run --claude demo && [ -f "$work/claude.args" ]'
check "reenvío tras --" 'run demo --claude -- "hola mundo" --resume && args claude | grep -qx "hola mundo" && args claude | grep -qx -- "--resume"'

check "error sin proyecto" '! run --claude && grep -q "indica un proyecto" "$work/out"'
check "error con dos proyectos" '! run demo otro && grep -q "demasiados argumentos" "$work/out"'
check "error con opción desconocida" '! run demo --foo && grep -q "opción desconocida" "$work/out"'
check "error con proyecto inexistente" '! run nada && grep -q "no existe" "$work/out"'
check "proyecto sin distinguir mayúsculas" 'run DeMo --copilot && grep -q "^┌ jdev-ai · demo · copilot$" "$work/out"'
check "nombre ambiguo por mayúsculas falla" 'git init -q "$work/h/projects/Doble" && git init -q "$work/h/projects/doble" && ! run DOBLE && grep -q "es ambiguo" "$work/out"'
check "coincidencia exacta tiene prioridad" 'run doble && [ -f "$work/claude.args" ]'
check "error con rutas" '! run ../x && grep -q "nombre de proyecto directo" "$work/out"'

check "«agent .» desde el harness" '(cd "$work/h" && run . --copilot) && grep -q "^┌ jdev-ai · h · copilot$" "$work/out"'
check "«agent .» fuera del harness falla" '! (cd "$work" && git init -q fuera && cd fuera && run .)'

summary() { (cd "$work/h/projects/demo" && "$status" "$@") > "$work/out"; }
check "resumen: última sesión por día y hora" 'summary && grep -q "^│ ÚLTIMA SESIÓN — 1 ene 2026 (.*) · quedó a medias$" "$work/out" && grep -q "^│ «Prueba»$" "$work/out"'
check "resumen: primeros puntos y resto" 'grep -q "^│   • Primer punto en dos líneas.$" "$work/out" && grep -q "^│   • Segundo punto.$" "$work/out" && ! grep -q "Tercer punto" "$work/out" && grep -q "(+1 punto más en 2026-01-01-1000-prueba.md)" "$work/out"'
check "resumen: OpenSpec con progreso y sin archivados" 'grep -q "OpenSpec abierto: cambio-x (1 de 3 tareas hechas)" "$work/out" && ! grep -q "viejo" "$work/out"'
check "resumen: pendiente de ti antes de seguir" 'grep -q "^│ PENDIENTE DE TI$" "$work/out" && grep -q "^│   ! Decidir el nombre definitivo.$" "$work/out" && [ "$(grep -n "PENDIENTE DE TI" "$work/out" | cut -d: -f1)" -lt "$(grep -n "POR DÓNDE SEGUIR" "$work/out" | cut -d: -f1)" ]'
check "resumen: todas las continuaciones" 'grep -q "^│   → Primera acción en dos líneas.$" "$work/out" && grep -q "^│   → Segunda.$" "$work/out"'
check "resumen: recuerda la puesta al día" 'grep -q "^└ .*«ponme al día»" "$work/out"'
check "resumen: todas las líneas con borde izquierdo" '[ "$(grep -vc "^[┌│└]" "$work/out")" -eq 0 ]'
check "resumen como systemMessage en una línea" 'echo "{}" | summary --hook && [ "$(wc -l < "$work/out")" -eq 1 ] && grep -q "^{\"systemMessage\":\"┌ jdev-ai · demo\\\\n.*\\\\n│ «Prueba»\\\\n.*/clear.*\"}$" "$work/out"'
check "resumen con el agente y los modelos del launcher" 'JDEV_SESSION_AGENT=codex JDEV_SESSION_ORCHESTRATOR="a [b]" JDEV_SESSION_IMPLEMENTER="c [d]" JDEV_SESSION_WARNING="aviso" summary && grep -q "^┌ jdev-ai · demo · codex$" "$work/out" && grep -q "^│ Orquestador a \[b\] · implementador c \[d\]$" "$work/out" && grep -q "^│ ⚠ aviso$" "$work/out"'

check "claude recibe el hook y no imprime el resumen" 'run demo && args claude | grep -q "^{\"hooks\":{\"SessionStart\":.*startup|clear.*session-status. --hook" && ! grep -q "jdev-ai ·" "$work/out"'
check "claude recibe los subagentes del adaptador" 'run demo && args claude | grep -qx -- "--agents" && args claude | grep -q "\"implementer\": {" && args claude | grep -q "\"Explore\": {"'
check "adaptador de claude es JSON válido" '! command -v python3 >/dev/null 2>&1 || python3 -m json.tool "$harness_root/adapters/claude/agents.json" >/dev/null'
check "claude falla sin adaptador de subagentes" 'mv "$work/h/adapters/claude/agents.json" "$work/agents.json" && ! run demo; r=$?; mv "$work/agents.json" "$work/h/adapters/claude/agents.json"; [ $r -eq 0 ] && grep -q "adaptador de subagentes" "$work/out"'
check "claude recibe el aviso de subagentes" 'run demo && args claude | grep -q "\"PreToolUse\":\[{\"matcher\":\"Agent\".*subagent-notice"'
notice() { printf '%s' "$1" | "$work/h/bin/subagent-notice"; }
check "aviso: subagente del adaptador con modelo y esfuerzo" '[ "$(notice "{\"model\":\"opus\",\"tool_input\":{\"description\":\"Buscar \\\"x\\\"\",\"prompt\":\"\\\"subagent_type\\\": \\\"otro\\\"\",\"subagent_type\":\"implementer\"}}")" = "{\"systemMessage\":\"⇢ Subagente implementer · sonnet [high] — Buscar \\\"x\\\"\"}" ]'
check "aviso: fork con el modelo de la sesión" 'notice "{\"tool_input\":{\"subagent_type\":\"fork\"}}" | grep -q "Subagente fork · modelo de la sesión\"}$"'
check "aviso: modelo indicado en la llamada" 'notice "{\"tool_input\":{\"subagent_type\":\"Explore\",\"model\":\"sonnet\"}}" | grep -q "Subagente Explore · sonnet \[medium\]\"}$"'
check "aviso: entrada no válida sin salida" '[ -z "$(notice basura)" ]'
check "codex recibe el hook" 'run demo --codex && args codex | grep -q "^hooks.SessionStart=.*startup|clear.*session-status. --hook" && ! grep -q "jdev-ai ·" "$work/out"'
check "copilot muestra el panel antes de abrirse" 'run demo --copilot && grep -q "^┌ jdev-ai · demo · copilot$" "$work/out"'

check "codex recibe las reglas del harness" 'run demo --codex && args codex | grep -q "^developer_instructions=" && args codex | grep -q "<harness> es $work/h"'
check "codex no duplica las reglas en el harness" '(cd "$work/h" && run . --codex) && ! args codex | grep -q "^developer_instructions="'
check "codex reenvía tras --" 'run demo --codex -- resume && [ "$(args codex | tail -n 2 | head -n 1)" = "resume" ]'
check "sin aviso con la versión verificada" 'run demo --codex && ! args codex | grep -q "^JDEV_SESSION_WARNING=."'
check "aviso con otra versión de codex" 'FAKE_CODEX_VERSION=0.0.1 run demo --codex && args codex | grep -q "^JDEV_SESSION_WARNING=codex 0.0.1 no verificado"'

# Worktrees de feature: proyecto aparte con commits e historial propios.
real_work=$(CDPATH= cd -- "$work" && pwd -P)
wtp="$real_work/h/projects/wtp"
wtp_trees="$real_work/h/projects/wtp.worktrees"
worktree="$work/h/bin/worktree"
mkdir -p "$wtp/.agent/history" "$wtp/cfg" "$wtp/carpeta"
git init -q -b main "$wtp"
git -C "$wtp" config user.name "Prueba"
git -C "$wtp" config user.email "prueba@example.com"
git -C "$wtp" config commit.gpgsign false
printf '.agent/\n.env\ncfg/\ncarpeta/\n' > "$wtp/.gitignore"
printf 'base\n' > "$wtp/conf.txt"
git -C "$wtp" add .gitignore conf.txt
git -C "$wtp" commit -q -m "base"
printf '# Historial del principal\n\nFecha: 2026-02-02 10:00\nEstado: finalizada\n' > "$wtp/.agent/history/2026-02-02-1000-principal.md"
wt() { (cd "$wtp" && PATH="$work/bin:$PATH" "$worktree" "$@") > "$work/wtout" 2> "$work/wterr"; }
wt_in() { dir=$1; shift; (cd "$dir" && PATH="$work/bin:$PATH" "$worktree" "$@") > "$work/wtout" 2> "$work/wterr"; }
commit_in() { printf '%s\n' "$3" > "$1/$2" && git -C "$1" add "$2" && git -C "$1" commit -q -m "cambio $2"; }
branches() { git -C "$wtp" branch --list 'feat/*' | wc -l | tr -d ' '; }

check "sintaxis de bin/worktree" 'sh -n "$harness_root/bin/worktree"'
check "worktree sin argumentos muestra la ayuda" '"$worktree" | grep -q "^Uso: worktree"'
check "worktree: comando desconocido falla" '! wt borrar x && grep -q "comando desconocido" "$work/wterr"'
check "worktree create crea rama y worktree con la ruta como única salida" 'wt create x && [ "$(cat "$work/wtout")" = "$wtp_trees/x" ] && [ -e "$wtp_trees/x/.git" ] && git -C "$wtp" rev-parse --verify -q refs/heads/feat/x >/dev/null && grep -q "creada desde main" "$work/wterr"'
check "worktree create es idempotente" 'before=$(git -C "$wtp" rev-parse feat/x) && wt create x && [ "$(cat "$work/wtout")" = "$wtp_trees/x" ] && grep -q "Worktree existente" "$work/wterr" && [ "$(git -C "$wtp" rev-parse feat/x)" = "$before" ] && [ "$(branches)" -eq 1 ]'
check "worktree create funciona desde el worktree" 'wt_in "$wtp_trees/x" create x && [ "$(cat "$work/wtout")" = "$wtp_trees/x" ]'
check "nombres inválidos fallan sin efectos" 'ok=0; for n in ../x .x -x A "a b" a..b a/b x.lock ""; do if wt create "$n"; then ok=1; fi; done; [ $ok -eq 0 ] && [ "$(branches)" -eq 1 ] && [ "$(ls "$wtp_trees")" = "x" ] && [ ! -e "$real_work/h/projects/x" ]'
check "rama desprotegida en otra ruta falla sin efectos" 'git -C "$wtp" worktree add -q -b feat/busy "$real_work/otro" && ! wt create busy && grep -q "otra ruta" "$work/wterr" && [ ! -e "$wtp_trees/busy" ]'
check "ruta ocupada que no es el worktree falla" 'mkdir -p "$wtp_trees/ocupada" && ! wt create ocupada && grep -q "ya existe" "$work/wterr" && ! git -C "$wtp" rev-parse --verify -q refs/heads/feat/ocupada >/dev/null'
check "worktree falla desde el harness" '! wt_in "$work/h" create x && grep -q "harness" "$work/wterr"'
check "worktree falla fuera de projects/" '! wt_in "$work/fuera" create x'

# Rutas de worktree-files: una válida, un directorio, una absoluta y una con «..».
mkdir -p "$wtp/carpeta/sub" "$real_work/h/projects/secreto"
printf 'principal\n' > "$wtp/.env"
printf 'cfg\n' > "$wtp/cfg/local.json"
printf 'dentro\n' > "$wtp/carpeta/sub/a.txt"
printf '# archivos locales\n\n.env\ncfg/local.json\n/etc/passwd\n../secreto\ncarpeta\nno-existe\n' > "$wtp/.agent/worktree-files"
check "worktree-files copia lo declarado y rechaza rutas absolutas o con «..»" 'wt create y && [ "$(cat "$wtp_trees/y/.env")" = "principal" ] && [ "$(cat "$wtp_trees/y/cfg/local.json")" = "cfg" ] && [ -f "$wtp_trees/y/carpeta/sub/a.txt" ] && grep -q "Copiado al worktree: .env" "$work/wterr" && grep -q "no permitida.*/etc/passwd" "$work/wterr" && grep -q "no permitida.*\.\./secreto" "$work/wterr" && [ ! -e "$wtp_trees/y/etc" ] && [ ! -e "$wtp_trees/secreto" ]'
check "worktree-files no sobrescribe" 'printf "local\n" > "$wtp_trees/y/.env" && printf "sucio\n" > "$wtp_trees/y/sucio.txt" && wt create y && [ "$(cat "$wtp_trees/y/.env")" = "local" ] && ! grep -q "Copiado" "$work/wterr"'

check "worktree list muestra rama y estado" 'wt list && grep -q "^  x .*feat/x .*limpio$" "$work/wtout" && grep -q "^  y .*feat/y .*con cambios$" "$work/wtout" && ! grep -q "^  wtp " "$work/wtout"'
check "worktree list sin worktrees lo indica" '(cd "$work/h/projects/demo" && "$worktree" list) | grep -q "No hay worktrees"'

# Integración: m1 limpia, c1 en conflicto, x con un commit sin integrar.
wt create m1 && wt create c1
printf 'principal\n' > "$wtp/conf.txt" && git -C "$wtp" commit -q -am "principal"
commit_in "$wtp_trees/m1" nuevo.txt "m1"
printf 'feature\n' > "$wtp_trees/c1/conf.txt" && git -C "$wtp_trees/c1" commit -q -am "feature"
commit_in "$wtp_trees/x" solo-x.txt "x"
check "merge con worktree sucio falla" '! wt merge y && grep -q "cambios sin confirmar" "$work/wterr"'
check "merge limpio crea un commit de merge --no-ff" 'before=$(git -C "$wtp" rev-parse HEAD) && wt merge m1 && [ "$(git -C "$wtp" rev-list --parents -n 1 HEAD | wc -w)" -eq 3 ] && [ -f "$wtp/nuevo.txt" ] && [ "$(git -C "$wtp" rev-parse HEAD^1)" = "$before" ] && grep -q "en main" "$work/wterr"'
check "merge con conflicto aborta y deja el principal intacto" 'head_before=$(git -C "$wtp" rev-parse HEAD) && status_before=$(git -C "$wtp" status --porcelain) && ! wt merge c1 && [ "$(git -C "$wtp" rev-parse HEAD)" = "$head_before" ] && [ "$(git -C "$wtp" status --porcelain)" = "$status_before" ] && ! git -C "$wtp" rev-parse -q --verify MERGE_HEAD >/dev/null && [ "$(cat "$wtp/conf.txt")" = "principal" ] && grep -q "cd .*c1 && git merge main" "$work/wterr"'
check "merge sin worktree falla" '! wt merge inexistente && grep -q "no existe el worktree" "$work/wterr"'

check "remove con cambios falla y no elimina nada" '! wt remove y && [ -d "$wtp_trees/y" ] && git -C "$wtp" rev-parse --verify -q refs/heads/feat/y >/dev/null'
check "remove desde dentro del worktree falla" '! wt_in "$wtp_trees/x/." remove x && grep -q "desde dentro" "$work/wterr" && [ -d "$wtp_trees/x" ]'
check "remove desde un subdirectorio del worktree falla" 'mkdir -p "$wtp_trees/x/sub" && ! wt_in "$wtp_trees/x/sub" remove x && [ -d "$wtp_trees/x" ]; r=$?; rmdir "$wtp_trees/x/sub"; [ $r -eq 0 ]'
check "remove de rama integrada borra worktree y rama" 'wt remove m1 && [ ! -e "$wtp_trees/m1" ] && ! git -C "$wtp" rev-parse --verify -q refs/heads/feat/m1 >/dev/null'
check "remove de rama no integrada conserva la rama y avisa" 'wt remove x && [ ! -e "$wtp_trees/x" ] && git -C "$wtp" rev-parse --verify -q refs/heads/feat/x >/dev/null && grep -q "no está integrada" "$work/wterr"'
check "create reutiliza la rama existente sin worktree" 'wt create x && [ -f "$wtp_trees/x/solo-x.txt" ] && grep -q "rama existente feat/x" "$work/wterr"'

# Integración por Pull Request: proyecto con remoto «origin» (bare temporal) y
# un «gh» simulado que lee su estado de $gh_state y registra cada llamada. Sin
# red ni el gh real.
wtr="$real_work/h/projects/wtr"
wtr_trees="$real_work/h/projects/wtr.worktrees"
bare="$real_work/remote.git"
gh_state="$work/gh"
mkdir -p "$gh_state"
git init -q --bare -b main "$bare"
git init -q -b main "$wtr"
git -C "$wtr" config user.name "Prueba"
git -C "$wtr" config user.email "prueba@example.com"
git -C "$wtr" config commit.gpgsign false
printf 'base\n' > "$wtr/conf.txt"
git -C "$wtr" add conf.txt
git -C "$wtr" commit -q -m "base"
git -C "$wtr" remote add origin "$bare"
git -C "$wtr" push -q -u origin main
cat > "$work/bin/gh" <<'EOF'
#!/bin/sh
# gh simulado. Estado en $FAKE_GH_DIR: «pr» («número estado base rama»),
# «checks» (pass|fail|none), «merge.fail» y «bare» (ruta del remoto).
d=$FAKE_GH_DIR
printf '%s\n' "$*" >> "$d/calls"
case "$1 $2" in
    "pr view")
        [ -f "$d/pr" ] || { echo "no pull requests found for branch \"$3\"" >&2; exit 1; }
        read -r n st base head < "$d/pr"
        printf '%s %s %s\n' "$n" "$st" "$base"
        ;;
    "pr checks")
        case "$(cat "$d/checks")" in
            pass) echo "All checks were successful"; exit 0 ;;
            fail) echo "build	fail" ; exit 1 ;;
            none) echo "no checks reported on the 'feat' branch" >&2; exit 1 ;;
        esac
        ;;
    "pr merge")
        [ ! -f "$d/merge.fail" ] || { echo "Pull request is not mergeable" >&2; exit 1; }
        read -r n st base head < "$d/pr"
        tmp=$(mktemp -d)
        git clone -q "$(cat "$d/bare")" "$tmp/c" 2>/dev/null
        cd "$tmp/c" && git checkout -q "$base" &&
            git -c user.name=GitHub -c user.email=noreply@example.com -c commit.gpgsign=false merge -q --no-ff -m "Merge pull request #$n" "origin/$head" &&
            git push -q origin "$base"
        r=$?
        rm -rf "$tmp"
        exit $r
        ;;
    *) echo "gh simulado: no soportado: $*" >&2; exit 2 ;;
esac
EOF
chmod +x "$work/bin/gh"
printf '%s\n' "$bare" > "$gh_state/bare"
export FAKE_GH_DIR="$gh_state"
gh_reset() { rm -f "$gh_state/pr" "$gh_state/merge.fail" "$gh_state/calls"; printf 'pass\n' > "$gh_state/checks"; : > "$gh_state/calls"; }
gh_pr() { printf '%s\n' "$1" > "$gh_state/pr"; }
gh_calls() { grep -c "$1" "$gh_state/calls" || true; }
wr() { (cd "$wtr" && PATH="$work/bin:$PATH" JDEV_WORKTREE_CHECKS_WAIT=0 "$worktree" "$@") > "$work/wtout" 2> "$work/wterr"; }
bare_main() { git -C "$bare" rev-parse refs/heads/main; }
# PATH sin gh con solo las herramientas que usa el script.
mkdir -p "$work/nogh"
for tool in git awk sed tr dirname cat mkdir rmdir mktemp grep sleep tee rm cp; do
    ln -s "$(command -v "$tool")" "$work/nogh/$tool"
done
gh_reset

check "worktree push sube la rama al remoto" 'wr create p1 && commit_in "$wtr_trees/p1" p1.txt p1 && wr push p1 && [ "$(git -C "$bare" rev-parse refs/heads/feat/p1)" = "$(git -C "$wtr_trees/p1" rev-parse HEAD)" ] && [ -z "$(cat "$work/wtout")" ]'
check "worktree push sin worktree falla" '! wr push nada && grep -q "no existe el worktree" "$work/wterr"'
check "worktree push sin origin falla" 'wt create sinorigen && ! wt push sinorigen && grep -q "origin" "$work/wterr"; r=$?; wt remove sinorigen; [ $r -eq 0 ]'

gh_pr "7 OPEN main feat/p1"
check "merge por PR integra en el remoto, borra la rama remota y actualiza el principal" 'old=$(git -C "$wtr" rev-parse HEAD) && wr merge p1 && [ "$(git -C "$wtr" rev-parse HEAD)" = "$(bare_main)" ] && [ "$(git -C "$wtr" rev-list --parents -n 1 HEAD | wc -w)" -eq 3 ] && [ "$(git -C "$wtr" rev-parse HEAD^1)" = "$old" ] && [ -f "$wtr/p1.txt" ] && ! git -C "$bare" rev-parse --verify -q refs/heads/feat/p1 >/dev/null && grep -q "worktree remove p1" "$work/wterr" && [ -z "$(cat "$work/wtout")" ]'
check "merge por PR consulta la PR, espera los checks e integra con --merge sin --delete-branch" '[ "$(gh_calls "^pr view feat/p1 --json number,state,baseRefName")" -eq 1 ] && [ "$(gh_calls "^pr checks 7 --watch --fail-fast$")" -eq 1 ] && [ "$(gh_calls "^pr merge 7 --merge$")" -eq 1 ] && [ "$(gh_calls "delete-branch")" -eq 0 ]'
check "remove tras el merge por PR borra worktree y rama local" 'wr remove p1 && [ ! -e "$wtr_trees/p1" ] && ! git -C "$wtr" rev-parse --verify -q refs/heads/feat/p1 >/dev/null && ! grep -q "no está integrada" "$work/wterr"'

gh_reset
wr create p2 && commit_in "$wtr_trees/p2" p2.txt p2
check "merge sin PR abierta falla sin integrar y explica cómo crearla" 'main_before=$(bare_main) && ! wr merge p2 && grep -q "gh pr create --base main --head feat/p2" "$work/wterr" && [ "$(gh_calls "^pr merge")" -eq 0 ] && [ "$(bare_main)" = "$main_before" ] && git -C "$bare" rev-parse --verify -q refs/heads/feat/p2 >/dev/null'
gh_pr "8 OPEN main feat/p2"
printf 'fail\n' > "$gh_state/checks"
check "merge con checks fallidos no integra" 'main_before=$(bare_main) && ! wr merge p2 && grep -q "checks de la PR #8 no han pasado" "$work/wterr" && [ "$(gh_calls "^pr merge")" -eq 0 ] && [ "$(bare_main)" = "$main_before" ] && [ "$(gh_calls "^pr checks")" -eq 1 ]'
gh_pr "8 OPEN develop feat/p2"
printf 'pass\n' > "$gh_state/checks"
check "merge con la base de la PR distinta falla sin integrar" 'main_before=$(bare_main) && ! wr merge p2 && grep -q "tiene como base develop" "$work/wterr" && [ "$(gh_calls "^pr merge")" -eq 0 ] && [ "$(bare_main)" = "$main_before" ]'
gh_pr "8 MERGED main feat/p2"
check "merge con la PR ya cerrada falla como si no hubiera PR" '! wr merge p2 && grep -q "estado MERGED" "$work/wterr" && [ "$(gh_calls "^pr merge")" -eq 0 ]'
gh_pr "8 OPEN main feat/p2"
printf 'none\n' > "$gh_state/checks"
touch "$gh_state/merge.fail"
: > "$gh_state/calls"
check "merge sin checks reintenta 3 veces y continúa; si gh no integra, falla" '! wr merge p2 && [ "$(gh_calls "^pr checks")" -eq 4 ] && grep -q "no tiene checks" "$work/wterr" && [ "$(gh_calls "^pr merge 8 --merge$")" -eq 1 ] && grep -q "gh no pudo integrar" "$work/wterr" && grep -q "git merge origin/main" "$work/wterr" && [ ! -f "$wtr/p2.txt" ]'
rm -f "$gh_state/merge.fail"
check "merge sin checks continúa e integra" 'wr merge p2 && [ -f "$wtr/p2.txt" ] && git -C "$bare" ls-tree -r --name-only main | grep -qx p2.txt && ! git -C "$bare" rev-parse --verify -q refs/heads/feat/p2 >/dev/null'
wr remove p2

check "merge sin gh en PATH falla y sugiere --local" 'wr create sg && commit_in "$wtr_trees/sg" sg.txt sg && ! (cd "$wtr" && PATH="$work/nogh" "$worktree" merge sg) > "$work/wtout" 2> "$work/wterr" && grep -q "falta «gh».*--local" "$work/wterr" && ! git -C "$bare" rev-parse --verify -q refs/heads/feat/sg >/dev/null'

gh_reset
check "merge --local mantiene el merge --no-ff local sin usar gh ni subir la rama" 'before=$(git -C "$wtr" rev-parse HEAD) && wr merge --local sg && [ "$(git -C "$wtr" rev-list --parents -n 1 HEAD | wc -w)" -eq 3 ] && [ "$(git -C "$wtr" rev-parse HEAD^1)" = "$before" ] && [ -f "$wtr/sg.txt" ] && [ ! -s "$gh_state/calls" ] && [ "$(bare_main)" != "$(git -C "$wtr" rev-parse HEAD)" ] && ! grep -q "Aviso" "$work/wterr"'
check "merge <feature> --local se admite tras la feature" 'wr create lo && commit_in "$wtr_trees/lo" lo.txt lo && wr merge lo --local && [ -f "$wtr/lo.txt" ] && [ ! -s "$gh_state/calls" ]'
check "merge con dos features falla" '! wr merge lo sg && grep -q "demasiados argumentos" "$work/wterr"'
wr remove sg; wr remove lo
git -C "$wtr" push -q origin main

wr create p3 && commit_in "$wtr_trees/p3" p3.txt p3
gh_pr "9 OPEN main feat/p3"
commit_in "$wtr" local-only.txt local
check "principal con commit local sin subir: la PR se integra, el ff no y se avisa con código 0" 'local_head=$(git -C "$wtr" rev-parse HEAD) && wr merge p3 && git -C "$bare" ls-tree -r --name-only main | grep -qx p3.txt && [ "$(git -C "$wtr" rev-parse HEAD)" = "$local_head" ] && [ ! -f "$wtr/p3.txt" ] && grep -q "AVISO: la PR #9 ya está integrada en GitHub" "$work/wterr" && ! grep -q "Integración completada" "$work/wterr"'
check "remove con el principal sin actualizar conserva la rama y avisa" 'wr remove p3 && git -C "$wtr" rev-parse --verify -q refs/heads/feat/p3 >/dev/null && grep -q "no está integrada" "$work/wterr"'

check "merge con el principal en HEAD desprotegido falla sin integrar" 'wr create dh && commit_in "$wtr_trees/dh" dh.txt dh && git -C "$wtr" checkout -q --detach && ! wr merge dh && grep -q "HEAD desprotegido" "$work/wterr"; r=$?; git -C "$wtr" checkout -q main; [ $r -eq 0 ]'
wr remove dh || true
git -C "$wtr" branch -D feat/dh >/dev/null 2>&1 || true

: > "$gh_state/calls"
wt create auto && commit_in "$wtp_trees/auto" auto.txt auto
check "proyecto sin origin integra en local automáticamente con aviso" 'wt merge auto && [ -f "$wtp/auto.txt" ] && grep -q "Aviso: .*no tiene remoto «origin»" "$work/wterr" && [ ! -s "$gh_state/calls" ]'
wt remove auto

# Launcher: --wt y «agent .» dentro de un worktree.
check "agent --wt crea el worktree y lanza claude en él" 'run wtp --wt lanz && [ "$(cat "$work/claude.cwd")" = "$wtp_trees/lanz" ] && [ -d "$wtp_trees/lanz" ] && git -C "$wtp" rev-parse --verify -q refs/heads/feat/lanz >/dev/null && grep -q "creada desde main" "$work/out"'
check "agent --wt exporta el checkout principal y la feature" 'run wtp --wt lanz && [ "$(sed -n 1p "$work/claude.env")" = "$wtp" ] && [ "$(sed -n 2p "$work/claude.env")" = "lanz" ] && run wtp && [ "$(sed -n 1p "$work/claude.env")" = "$wtp" ] && [ -z "$(sed -n 2p "$work/claude.env")" ]'
check "claude recibe solo el .git común y el historial como directorios adicionales" 'run wtp --wt lanz -- "hola" && [ "$(args claude | grep -cx -- "--add-dir")" -eq 2 ] && args claude | grep -qx "$wtp/.git" && args claude | grep -qx "$wtp/.agent/history" && ! args claude | grep -qx "$wtp" && [ "$(args claude | grep -n -x -- "--add-dir" | tail -n 1 | cut -d: -f1)" -lt "$(args claude | grep -n -x -- "--settings" | cut -d: -f1)" ] && args claude | grep -qx "hola"'
check "codex recibe solo el .git común y el historial como directorios adicionales" 'run wtp --wt lanz --codex && [ "$(cat "$work/codex.cwd")" = "$wtp_trees/lanz" ] && [ "$(args codex | grep -cx -- "--add-dir")" -eq 2 ] && args codex | grep -qx "$wtp/.git" && args codex | grep -qx "$wtp/.agent/history" && ! args codex | grep -qx "$wtp"'
check "copilot no recibe --add-dir pero se abre en el worktree" 'run wtp --wt lanz --copilot && [ "$(cat "$work/copilot.cwd")" = "$wtp_trees/lanz" ] && ! args copilot | grep -qx -- "--add-dir"'
check "sin --wt codex solo recibe el directorio de worktrees y claude nada" 'run wtp --codex && [ "$(args codex | grep -cx -- "--add-dir")" -eq 1 ] && args codex | grep -qx "$wtp_trees" && [ -d "$wtp_trees" ] && [ "$(cat "$work/codex.cwd")" = "$wtp" ] && run wtp && ! args claude | grep -qx -- "--add-dir"'
check "codex en el harness no recibe directorio de worktrees" '(cd "$work/h" && run . --codex) && ! args codex | grep -qx -- "--add-dir"'
check "«agent .» dentro de un worktree abre el agente en él" '(cd "$wtp_trees/lanz" && run . --codex) && [ "$(cat "$work/codex.cwd")" = "$wtp_trees/lanz" ] && args codex | grep -qx "$wtp/.git" && args codex | grep -qx "$wtp/.agent/history" && ! args codex | grep -qx "$wtp" && [ "$(sed -n 2p "$work/codex.env")" = "lanz" ] && [ "$(sed -n 1p "$work/codex.env")" = "$wtp" ]'
check "«agent .» en un subdirectorio del worktree abre la raíz del worktree" 'mkdir -p "$wtp_trees/lanz/sub" && (cd "$wtp_trees/lanz/sub" && run .) && [ "$(cat "$work/claude.cwd")" = "$wtp_trees/lanz" ]'
check "«agent .» en un worktree fuera de projects/ falla" 'git init -q -b main "$work/fuera2" && git -C "$work/fuera2" -c user.name=x -c user.email=x@example.com commit -q --allow-empty -m base && git -C "$work/fuera2" worktree add -q "$work/fuera2-wt" -b otra && ! (cd "$work/fuera2-wt" && run .) && grep -q "no es el harness ni está dentro" "$work/out"'
check "--wt sobre el harness falla" '! (cd "$work/h" && run . --wt x) && grep -q "no se admite sobre el harness" "$work/out" && [ ! -e "$work/h/projects/h.worktrees" ]'
check "--wt sin valor falla" '! run wtp --wt && grep -q "requiere el nombre" "$work/out"'
check "--wt con nombre inválido falla sin lanzar el agente" '! run wtp --wt ../x && [ ! -f "$work/claude.args" ] && grep -q "nombre de la feature" "$work/out"'
check "--wt se admite en cualquier orden" 'run --wt orden --codex wtp && [ "$(cat "$work/codex.cwd")" = "$wtp_trees/orden" ]'

# Panel: historial del principal y datos del worktree.
psummary() { (cd "$1" && "$status" ${2:+"$2"}) > "$work/out"; }
check "panel en un worktree: historial del principal, feature y rama" 'psummary "$wtp_trees/lanz" && grep -q "^┌ jdev-ai · wtp$" "$work/out" && grep -q "^│ «Historial del principal»$" "$work/out" && grep -q "^│ Worktree lanz · rama feat/lanz$" "$work/out" && [ "$(grep -vc "^[┌│└]" "$work/out")" -eq 0 ]'
check "panel en el principal: lista los worktrees abiertos" 'psummary "$wtp" && grep -q "^│ Worktrees abiertos: .*lanz" "$work/out" && grep -q "agent wtp --wt <nombre>" "$work/out" && ! grep -q "^│ Worktree " "$work/out" && [ "$(grep -vc "^[┌│└]" "$work/out")" -eq 0 ]'
check "panel sin worktrees no añade líneas de worktree" 'psummary "$work/h/projects/demo" && ! grep -q "Worktree" "$work/out"'
check "panel en modo hook desde un worktree" 'echo "{}" | psummary "$wtp_trees/lanz" --hook && [ "$(wc -l < "$work/out")" -eq 1 ] && grep -q "Worktree lanz · rama feat/lanz" "$work/out"'

if [ "$failures" -gt 0 ]; then
    printf '\n%s comprobaciones fallidas\n' "$failures"
    exit 1
fi
printf '\nTodas las comprobaciones han pasado\n'
