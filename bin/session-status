#!/bin/sh

# Resumen de inicio de sesión de jdev-ai para el repositorio del directorio
# actual: qué se hizo la última vez, qué ha pasado desde entonces y por dónde
# seguir. Sin argumentos imprime el resumen; con --hook lo devuelve como JSON
# «systemMessage» para que el hook SessionStart del agente lo muestre dentro de
# la sesión. El agente y sus modelos llegan del launcher por variables
# JDEV_SESSION_*, para que el comando del hook sea idéntico en todos los
# proyectos (Codex pide confiar de nuevo en cualquier hook que cambie).

set -eu

mode=text
case "${1:-}" in
    "") ;;
    --hook) mode=hook ;;
    *)
        printf 'Uso: session-status [--hook]\n' >&2
        exit 2
        ;;
esac

summary_points=2
continuation_points=3
worktree_names_shown=5
wrap_width=74

json_string() {
    awk '
        BEGIN { ORS = ""; print "\"" }
        {
            gsub(/\\/, "\\\\")
            gsub(/"/, "\\\"")
            gsub(/\t/, "\\t")
            gsub(/\r/, "")
            if (NR > 1) print "\\n"
            print
        }
        END { print "\"" }
    '
}

# Imprime los puntos de primer nivel de una sección del historial, uno por
# línea, uniendo sus líneas de continuación.
section_points() {
    awk -v wanted="## $2" '
        $0 == wanted { section = 1; next }
        section && /^## / { exit }
        section && /^- / {
            if (text != "") print text
            text = substr($0, 3)
            next
        }
        section && text != "" && /^  +[^ ]/ {
            sub(/^ +/, "")
            text = text " " $0
            next
        }
        section && text != "" { print text; text = "" }
        END { if (text != "") print text }
    ' "$1"
}

# Ajusta un texto al ancho del panel con una sangría para la primera línea y
# otra para las siguientes.
wrap() {
    printf '%s\n' "$3" | awk -v first="$1" -v rest="$2" -v width="$wrap_width" '
        {
            prefix = first
            line = ""
            n = split($0, words, " ")
            for (i = 1; i <= n; i++) {
                if (line != "" && length(prefix line " " words[i]) > width) {
                    print prefix line
                    prefix = rest
                    line = words[i]
                } else {
                    line = (line == "" ? words[i] : line " " words[i])
                }
            }
            if (line != "") print prefix line
        }
    '
}

# Convierte «YYYY-MM-DD» en «18 sep 2026» sin depender del locale.
human_date() {
    set -- $(printf '%s' "$1" | tr '-' ' ')
    case "$2" in
        01) month=ene ;; 02) month=feb ;; 03) month=mar ;; 04) month=abr ;;
        05) month=may ;; 06) month=jun ;; 07) month=jul ;; 08) month=ago ;;
        09) month=sep ;; 10) month=oct ;; 11) month=nov ;; 12) month=dic ;;
        *) printf '%s-%s-%s' "$1" "$2" "$3"; return ;;
    esac
    printf '%s %s %s' "${3#0}" "$month" "$1"
}

# Días naturales transcurridos desde «YYYY-MM-DD» expresados en lenguaje
# natural. Necesita la date de GNU; sin ella no imprime nada.
relative_day() {
    then_s=$(date -d "$1" +%s 2>/dev/null) || return 0
    today_s=$(date -d "$(date +%Y-%m-%d)" +%s 2>/dev/null) || return 0
    # El margen de medio día absorbe los cambios de horario de verano.
    days=$(( (today_s - then_s + 43200) / 86400 ))
    if [ "$days" -le 0 ]; then
        printf 'hoy'
    elif [ "$days" -eq 1 ]; then
        printf 'ayer'
    elif [ "$days" -lt 60 ]; then
        printf 'hace %s días' "$days"
    else
        printf 'hace %s meses' "$((days / 30))"
    fi
}

# Elige la entrada más reciente y la imprime como «día<TAB>HHMM<TAB>ruta». El
# día y la hora salen de «Fecha:», del nombre (YYYY-MM-DD-HHMM) o, si faltan,
# de la fecha de modificación. Ordenar solo por nombre no basta: hay entradas
# sin hora que quedarían por delante de otras posteriores del mismo día.
latest_history() {
    [ -d "$history_dir" ] || return 0
    for file in "$history_dir"/*.md; do
        [ -f "$file" ] || continue
        stamp=$(sed -n 's/^Fecha: *//p' "$file" | head -n 1)
        name=${file##*/}
        case "$stamp" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*) day=$(printf '%s' "$stamp" | cut -c 1-10) ;;
            *)
                case "$name" in
                    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*) day=$(printf '%s' "$name" | cut -c 1-10) ;;
                    *) day=$(date -r "$file" +%Y-%m-%d 2>/dev/null || echo 0000-00-00) ;;
                esac
                ;;
        esac
        case "$stamp" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]" "[0-9][0-9]:[0-9][0-9]*) clock=$(printf '%s' "$stamp" | cut -c 12-16 | tr -d ':') ;;
            *)
                case "$name" in
                    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]-*) clock=$(printf '%s' "$name" | cut -c 12-15) ;;
                    *) clock=$(date -r "$file" +%H%M 2>/dev/null || echo 0000) ;;
                esac
                ;;
        esac
        printf '%s\t%s\t%s\n' "$day" "$clock" "$file"
    done | LC_ALL=C sort | tail -n 1
}

count_matches() {
    grep -c "$1" "$2" 2>/dev/null || true
}

# Nombres de los worktrees abiertos del checkout principal «$1», uno por línea.
open_worktrees() {
    git -C "$1" worktree list --porcelain 2>/dev/null | awk '
        /^worktree / { n++; if (n > 1) print substr($0, 10) }
    ' | while IFS= read -r path; do
        [ -d "$path" ] || continue
        case "$path" in
            "${1%/*}/${1##*/}.worktrees/"*) printf '%s\n' "${path#"${1%/*}/${1##*/}.worktrees/"}" ;;
            *) printf '%s\n' "${path##*/}" ;;
        esac
    done
}

panel() {
    project_dir=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
    cd -- "$project_dir"
    project_dir=$(pwd -P)

    has_git=0
    git rev-parse --git-dir >/dev/null 2>&1 && has_git=1

    # El historial es único por proyecto y vive en el checkout principal, que
    # en un worktree es el padre del .git común.
    main_checkout=$project_dir
    is_worktree=0
    if [ "$has_git" -eq 1 ]; then
        common_dir=$(git rev-parse --git-common-dir 2>/dev/null) && \
            common_dir=$(CDPATH= cd -- "$common_dir" 2>/dev/null && pwd -P) || common_dir=
        if [ -n "$common_dir" ] && [ "${common_dir##*/}" = ".git" ] && [ "${common_dir%/*}" != "$project_dir" ]; then
            main_checkout=${common_dir%/*}
            is_worktree=1
        fi
    elif [ -n "${JDEV_MAIN_CHECKOUT:-}" ] && [ -d "$JDEV_MAIN_CHECKOUT" ]; then
        main_checkout=$JDEV_MAIN_CHECKOUT
    fi
    history_dir="$main_checkout/.agent/history"
    project_name=${main_checkout##*/}

    header="jdev-ai · $project_name"
    [ -z "${JDEV_SESSION_AGENT:-}" ] || header="$header · $JDEV_SESSION_AGENT"
    printf '┌ %s\n' "$header"
    if [ -n "${JDEV_SESSION_ORCHESTRATOR:-}" ]; then
        printf '│ Orquestador %s · implementador %s\n' "$JDEV_SESSION_ORCHESTRATOR" "${JDEV_SESSION_IMPLEMENTER:-}"
    fi
    [ -z "${JDEV_SESSION_WARNING:-}" ] || wrap '│ ⚠ ' '│   ' "$JDEV_SESSION_WARNING"
    if [ "$is_worktree" -eq 1 ]; then
        wt_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "HEAD desprotegido")
        case "$project_dir" in
            "${main_checkout%/*}/$project_name.worktrees/"*) wt_name=${project_dir#"${main_checkout%/*}/$project_name.worktrees/"} ;;
            *) wt_name=${project_dir##*/} ;;
        esac
        printf '│ Worktree %s · rama %s\n' "$wt_name" "$wt_branch"
    elif [ "$has_git" -eq 1 ]; then
        all_names=$(open_worktrees "$main_checkout")
        if [ -n "$all_names" ]; then
            total_names=$(printf '%s\n' "$all_names" | wc -l | tr -d ' ')
            open_names=$(printf '%s\n' "$all_names" | head -n "$worktree_names_shown" | tr '\n' ' ' | sed 's/ $//; s/ /, /g')
            [ "$total_names" -le "$worktree_names_shown" ] || \
                open_names="$open_names (+$((total_names - worktree_names_shown)) más)"
            wrap '│ Worktrees abiertos: ' '│   ' "$open_names"
            printf '│   Retómalos con: agent %s --wt <nombre>\n' "$project_name"
        fi
    fi
    printf '│\n'

    latest=$(latest_history)
    history_file=$(printf '%s' "$latest" | cut -f 3)
    history_day=
    history_since=
    history_status=

    if [ -n "$history_file" ]; then
        history_title=$(sed -n '1{s/^# *//;p;}' "$history_file")
        [ -n "$history_title" ] || history_title=${history_file##*/}
        history_stamp=$(sed -n 's/^Fecha: *//p' "$history_file" | head -n 1)
        history_status=$(sed -n 's/^Estado: *//p' "$history_file" | head -n 1)
        history_day=$(printf '%s' "$history_stamp" | cut -c 1-10)
        # Sin «Fecha:» válida se usa el día deducido del nombre o del archivo.
        case "$history_day" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
            *)
                history_day=$(printf '%s' "$latest" | cut -f 1)
                history_stamp=$history_day
                ;;
        esac

        # Se compara por prefijo porque algunas entradas añaden detalles tras
        # el estado («bloqueada por …»).
        case "$history_status" in
            finalizada*|terminada*|cerrad*) status_text="terminada" ;;
            "en curso"*) status_text="quedó a medias" ;;
            bloqueada*) status_text="quedó bloqueada" ;;
            "") status_text="estado sin indicar" ;;
            *) status_text="estado: $(printf '%s' "$history_status" | cut -c 1-40)" ;;
        esac

        case "$history_day" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
                when=$(human_date "$history_day")
                ago=$(relative_day "$history_day")
                [ -z "$ago" ] || when="$when ($ago)"
                # Sin hora, la sesión cubre todo su día: «desde entonces»
                # empieza al día siguiente.
                case "$history_stamp" in
                    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]" "[0-9][0-9]:[0-9][0-9]*) history_since=$(printf '%s' "$history_stamp" | cut -c 1-16) ;;
                    *) history_since="$history_day 23:59:59" ;;
                esac
                ;;
            *) when="fecha sin indicar" ;;
        esac

        printf '│ ÚLTIMA SESIÓN — %s · %s\n' "$when" "$status_text"
        wrap '│ «' '│  ' "$history_title»"

        points=$(section_points "$history_file" Resumen)
        total=0
        shown=0
        if [ -n "$points" ]; then
            total=$(printf '%s\n' "$points" | wc -l | tr -d ' ')
            printf '%s\n' "$points" | head -n "$summary_points" | while IFS= read -r point; do
                wrap '│   • ' '│     ' "$point"
            done
            shown=$(( total < summary_points ? total : summary_points ))
        fi
        hidden=$((total - shown))
        if [ "$hidden" -eq 1 ]; then
            printf '│   (+1 punto más en %s)\n' "${history_file##*/}"
        elif [ "$hidden" -gt 1 ]; then
            printf '│   (+%s puntos más en %s)\n' "$hidden" "${history_file##*/}"
        fi
    else
        printf '│ ÚLTIMA SESIÓN — no hay sesiones registradas en este proyecto.\n'
    fi
    printf '│\n'

    if [ -n "$history_file" ]; then
        printf '│ DESDE ENTONCES\n'
    else
        printf '│ ESTADO ACTUAL\n'
    fi

    changed=0
    active_changes=
    if [ "$has_git" -eq 1 ]; then
        branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo "sin commits")

        if [ -n "$history_since" ]; then
            new_commits=$(git log --since="$history_since" --format=%h 2>/dev/null | wc -l | tr -d ' ')
            if [ "$new_commits" -eq 0 ]; then
                printf '│   • Ningún commit nuevo.\n'
            else
                [ "$new_commits" -eq 1 ] && commit_word="commit nuevo" || commit_word="commits nuevos"
                last_day=$(git log -1 --format=%cd --date=short 2>/dev/null)
                last_subject=$(git log -1 --format=%s 2>/dev/null)
                printf '│   • %s %s, el último %s:\n' "$new_commits" "$commit_word" "$(relative_day "$last_day")"
                wrap '│     «' '│      ' "$last_subject»"
            fi
        elif last_day=$(git log -1 --format=%cd --date=short 2>/dev/null) && [ -n "$last_day" ]; then
            printf '│   • Último commit %s:\n' "$(relative_day "$last_day")"
            wrap '│     «' '│      ' "$(git log -1 --format=%s)»"
        fi

        changed=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        if [ "$changed" -eq 0 ]; then
            printf '│   • Sin cambios locales en %s.\n' "$branch"
        elif [ "$changed" -eq 1 ]; then
            printf '│   • Tienes 1 archivo con cambios sin commit en %s.\n' "$branch"
        else
            printf '│   • Tienes %s archivos con cambios sin commit en %s.\n' "$changed" "$branch"
        fi
    else
        printf '│   • El directorio no es un repositorio Git.\n'
    fi

    if [ -d openspec/changes ]; then
        for change_dir in openspec/changes/*; do
            [ -d "$change_dir" ] || continue
            change_name=${change_dir##*/}
            [ "$change_name" = "archive" ] && continue
            active_changes="$active_changes $change_name"

            progress=
            if [ -f "$change_dir/tasks.md" ]; then
                done_tasks=$(count_matches '^[[:space:]]*- \[[xX]\]' "$change_dir/tasks.md")
                open_tasks=$(count_matches '^[[:space:]]*- \[ \]' "$change_dir/tasks.md")
                all_tasks=$((done_tasks + open_tasks))
                [ "$all_tasks" -eq 0 ] || progress=" ($done_tasks de $all_tasks tareas hechas)"
            fi
            wrap '│   • OpenSpec abierto: ' '│     ' "$change_name$progress"
        done
    fi
    [ -n "$active_changes" ] || printf '│   • Sin cambios OpenSpec abiertos.\n'
    printf '│\n'

    pending_points=
    [ -z "$history_file" ] || pending_points=$(section_points "$history_file" "Pendiente de ti")
    if [ -n "$pending_points" ]; then
        printf '│ PENDIENTE DE TI\n'
        printf '%s\n' "$pending_points" | while IFS= read -r point; do
            wrap '│   ! ' '│     ' "$point"
        done
        printf '│\n'
    fi

    printf '│ POR DÓNDE SEGUIR\n'
    next_points=
    [ -z "$history_file" ] || next_points=$(section_points "$history_file" "Continuación recomendada")
    if [ -n "$next_points" ]; then
        printf '%s\n' "$next_points" | head -n "$continuation_points" | while IFS= read -r point; do
            wrap '│   → ' '│     ' "$point"
        done
    elif [ "$changed" -gt 0 ]; then
        printf '│   → Revisa los cambios locales antes de empezar otra tarea.\n'
    elif [ -n "$active_changes" ]; then
        printf '│   → Continúa el cambio OpenSpec abierto.\n'
    else
        printf '│   → Describe una tarea nueva o pide al agente que proponga el siguiente paso.\n'
    fi

    printf '│\n'
    if [ "$mode" = "hook" ]; then
        printf '│ ¿Hace tiempo que no lo tocas? Pide «ponme al día» para un resumen detallado.\n'
        printf '└ Usa /clear para volver a ver este resumen.\n'
    else
        printf '└ ¿Hace tiempo que no lo tocas? Pide «ponme al día» para un resumen detallado.\n'
    fi
}

if [ "$mode" = "hook" ]; then
    # El agente envía por stdin el evento en JSON; el resumen no lo necesita.
    # Si se ejecuta a mano desde una terminal, no espera a que se escriba nada.
    [ -t 0 ] || cat >/dev/null 2>&1 || true
    printf '{"systemMessage":%s}\n' "$(panel | json_string)"
else
    panel
fi
