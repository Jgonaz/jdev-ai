---
// Esquema de la apertura: un único AGENTS.md del que beben los cuatro agentes.
// Un pulso sale del centro hacia cada agente por turnos (SMIL, sin JS); con
// «reducir movimiento» el esquema se queda quieto.
import PanelAgentIcon from './PanelAgentIcon.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
const cx = 180;
const cy = 92;
const agents = [
  { id: 'claude', name: 'Claude Code', x: 44, y: 34, lx: 44, ly: 76 },
  { id: 'codex', name: 'Codex', x: 316, y: 34, lx: 316, ly: 76 },
  { id: 'copilot', name: 'Copilot', x: 44, y: 150, lx: 44, ly: 192 },
  { id: 'opencode', name: 'OpenCode', x: 316, y: 150, lx: 316, ly: 192 },
];
// Curva suave del centro al agente: sale en horizontal y llega en horizontal.
const path = (x: number, y: number) => {
  const sx = x < cx ? cx - 52 : cx + 52;
  const mx = (sx + x) / 2;
  return `M${sx} ${cy} C${mx} ${cy} ${mx} ${y} ${x < cx ? x + 22 : x - 22} ${y}`;
};
const cycle = 4.8;
const step = cycle / agents.length;
const reach = 0.7 / cycle;
---

<figure class="hub" role="img" aria-label={label}>
  <svg viewBox="0 0 360 200" width="360" height="200" aria-hidden="true" focusable="false">
    {
      agents.map((a) => (
        <path id={`hub-${a.id}`} class="hub__wire" d={path(a.x, a.y)} />
      ))
    }
    {
      agents.map((a, i) => (
        <g class={`hub__agent hub__agent--${a.id}`}>
          <circle class="hub__ring" cx={a.x} cy={a.y} r="21">
            <animate
              class="hub__anim"
              attributeName="stroke-opacity"
              values="0.35;0.35;1;0.35"
              keyTimes={`0;${reach * 0.85};${reach};1`}
              dur={`${cycle}s`}
              begin={`${i * step}s`}
              repeatCount="indefinite"
            />
          </circle>
          <svg x={a.x - 9} y={a.y - 9} width="18" height="18" viewBox="0 0 18 18" overflow="visible">
            <PanelAgentIcon agent={a.id} size={18} />
          </svg>
          <text class="hub__name" x={a.lx} y={a.ly} text-anchor="middle">{a.name}</text>
          <circle class="hub__pulse" r="3">
            <animateMotion
              dur={`${cycle}s`}
              begin={`${i * step}s`}
              repeatCount="indefinite"
              keyPoints="0;1;1"
              keyTimes={`0;${reach};1`}
              calcMode="linear"
            >
              <mpath href={`#hub-${a.id}`} />
            </animateMotion>
            <animate
              attributeName="opacity"
              values="1;1;0;0"
              keyTimes={`0;${reach};${reach + 0.01};1`}
              dur={`${cycle}s`}
              begin={`${i * step}s`}
              repeatCount="indefinite"
            />
          </circle>
        </g>
      ))
    }
    <rect class="hub__core" x={cx - 52} y={cy - 19} width="104" height="38" rx="9" />
    <text class="hub__file" x={cx} y={cy + 5} text-anchor="middle">AGENTS.md</text>
  </svg>
</figure>

<style>
  .hub {
    --c-claude: #e58a62;
    --c-codex: #8fa8ff;
    --c-copilot: #c3a6fb;
    --c-opencode: #6fd3e6;
    margin: 0;
    justify-self: end;
    align-self: center;
  }

  .hub svg {
    display: block;
    width: 300px;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }

  .hub__wire {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.2;
    stroke-dasharray: 3 4;
  }

  .hub__core {
    fill: var(--accent-bg);
    stroke: var(--accent-line);
  }

  .hub__file {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    fill: var(--accent-text);
  }

  .hub__ring {
    fill: var(--bg-panel);
    stroke: var(--c);
    stroke-width: 1.4;
    stroke-opacity: 0.35;
  }

  .hub__name {
    font-family: var(--font-mono);
    font-size: 12.5px;
    fill: var(--fg-muted);
  }

  .hub__pulse {
    fill: var(--c);
    opacity: 0;
  }

  .hub__agent :global(.pn-agenticon) {
    color: var(--c);
  }

  .hub__agent--claude {
    --c: var(--c-claude);
  }

  .hub__agent--codex {
    --c: var(--c-codex);
  }

  .hub__agent--copilot {
    --c: var(--c-copilot);
  }

  .hub__agent--opencode {
    --c: var(--c-opencode);
  }

  @media (prefers-reduced-motion: reduce) {
    .hub__pulse {
      display: none;
    }

    .hub__ring {
      stroke-opacity: 0.7 !important;
    }
  }
</style>
