---
// Simulación del panel gráfico con datos inventados. Reproduce la pantalla
// todas las pantallas del menú: Inicio, Terminales, Proyectos, Historial y
// Ajustes. El estado vive en atributos del panel que leen el CSS y el script.
import type { Dictionary } from '../i18n/es';
import PanelAgentIcon from './PanelAgentIcon.astro';
import PanelContext from './PanelContext.astro';
import PanelHistory from './PanelHistory.astro';
import PanelProjects from './PanelProjects.astro';
import PanelSettings from './PanelSettings.astro';
import PanelWork from './PanelWork.astro';
import { panelInitialSession, panelSims } from '../data/activityMap';
import { settingsScreen } from '../data/settings';

interface Props {
  t: Dictionary['panel'];
  mapNames: Dictionary['map']['stations'];
  lang: 'es' | 'en';
}

const { t, lang, mapNames } = Astro.props;
const { ui, home, projects, sessions } = t;
const periods = ['week', 'month', 'all'] as const;
const colorOf = (name: string) => projects.find((p) => p.name === name)?.color;
const monoOf = (name: string) => projects.find((p) => p.name === name)?.mono;
// Mapa de calor de ejemplo: 12 semanas por 7 días con un patrón fijo, más flojo en fin de semana.
const heat = Array.from({ length: 7 }, (_, day) =>
  Array.from({ length: 12 }, (_, week) => {
    const n = (week * 7 + day * 13 + week * day * 5) % 11;
    const level = n < 2 ? 0 : n < 5 ? 1 : n < 8 ? 2 : n < 10 ? 3 : 4;
    return day > 4 ? Math.max(0, level - 2) : level;
  }),
);
// La sesión elegida al cargar es la que trabaja, no la primera de la lista: así el mapa y el terminal se ven en movimiento.
// El orden de las sesiones no cambia y la barra de tmux de cada una marca con `*` la suya.
const first = sessions.find((s) => s.id === panelInitialSession)?.id ?? sessions[0].id;
const projOf = (name: string) => projects.findIndex((p) => p.name === name);
const projOfSession = (id: string) => projOf(sessions.find((s) => s.id === id)?.project ?? '');
// Posición de cada sesión viva en la barra de tmux, como en el panel real.
const live = sessions.filter((s) => s.state !== 'done');
const tmux = (id: string) => live.map((s, i) => `${i}:${s.project}${s.id === id ? '*' : ''}`).join('  ');
---

<div
  class="pn"
  data-panel
  data-view="term"
  data-period="week"
  data-on-ascii
  data-on-greeting
  data-on-grid
  data-on-tmux
  data-on-vis0
  data-on-vis1
  data-on-vis2
  role="region" aria-label={ui.label}>
  <noscript><p class="pn-noscript">{ui.noScript}</p></noscript>
  <div class="pn-window">
    <span>localhost:4317</span>
    <span>{ui.bar}</span>
  </div>

  <div class="pn-head">
    <span class="pn-logo"><span>~/</span>Jdev-ai<i class="caret" aria-hidden="true"></i></span>
    <div class="pn-nav" role="group" aria-label={ui.navLabel}>
      {
        ui.nav.map((item) => (
          <button type="button" data-screen-btn={item.id} aria-pressed={item.id === 'terminales' ? 'true' : 'false'}>
            {item.label}
          </button>
        ))
      }
    </div>
    <span class="pn-limits" aria-hidden="true">
      <span class="pn-lim">5 h <span class="pn-lim__track"><span style="width:11%" /></span> <b>11 %</b></span>
      <span class="pn-lim">7 d <span class="pn-lim__track"><span style="width:26%" /></span> <b>26 %</b></span>
    </span>
    <span class="pn-agent">
      <span aria-hidden="true">&gt;_</span>
      {
        settingsScreen[lang].agents.agents.map((agent, i) => (
          <b data-when={`agent:${agent.id}`} hidden={i !== 0}>
            {agent.label}
          </b>
        ))
      }
    </span>
    <span class="pn-new">+ {ui.newSession}</span>
  </div>

  <div class="pn-screen" data-screen="terminales">
    <div class="pn-side">
      <span class="pn-side__title">
        {ui.projects} (<span data-proj-count>{projects.length}</span>)
      </span>
      {
        projects.map((project) => (
          <div class="pn-project" data-proj={projects.indexOf(project)}>
            <div class="pn-project__name">
              <span class="pn-mono" style={`background:${project.color}`}>
                {project.mono}
              </span>
              {project.name}
              <span class="pn-project__act" aria-hidden="true">+</span>
              <span class="pn-project__act" aria-hidden="true">▶</span>
              <span class="pn-project__count" aria-hidden="true">{sessions.filter((s) => s.project === project.name).length}</span>
            </div>
            {sessions
              .filter((s) => s.project === project.name)
              .map((s) => (
                <button
                  type="button"
                  class={`pn-row pn-row--${s.state}`}
                  data-pick={s.id}
                  data-proj={projOf(s.project)}
                  aria-pressed={s.id === first ? 'true' : 'false'}
                >
                  <span class={`pn-light pn-light--${s.state}`} role="img" aria-label={ui.states[s.state]} />
                  <span class="pn-row__text">
                    <span class="pn-row__title">{s.title}</span>
                    <span class="pn-row__state">{s.branch} · {s.agent}</span>
                  </span>
                  <span class="pn-row__time">{s.time}</span>
                </button>
              ))}
          </div>
        ))
      }
      <div class="pn-legend">
        <span class="pn-legend__title">{ui.legend}</span>
        {
          (['waiting', 'working', 'idle', 'done'] as const).map((state) => (
            <span class="pn-legend__row">
              <span class={`pn-light pn-light--${state}`} aria-hidden="true" /> {ui.states[state]}
            </span>
          ))
        }
      </div>
    </div>

    <div class="pn-empty" data-empty>
      <span>{ui.noProjects}</span>
      <button type="button" data-screen-btn="ajustes" data-goto="sec:proyectos">{ui.noProjectsAction}</button>
    </div>

    <div class="pn-main">
      <div class="pn-tabs" role="group" aria-label={ui.tabsLabel}>
        {
          sessions.map((s) => (
            <button
              type="button"
              class={`pn-tab pn-row--${s.state}`}
              data-pick={s.id}
              data-proj={projOf(s.project)}
              data-tab-done={s.state === 'done' ? '' : undefined}
              hidden={s.state === 'done'}
              aria-pressed={s.id === first ? 'true' : 'false'}
            >
              <PanelAgentIcon agent={s.agent} size={13} />
              {s.title}
              <span class={`pn-light pn-light--${s.state}`} role="img" aria-label={ui.states[s.state]} />
            </button>
          ))
        }
      </div>

      {
        sessions.map((s) => (
          <div class="pn-pane" data-pane={s.id} data-proj={projOf(s.project)} hidden={s.id !== first}>
            <div class={`pn-tcard${s.state === 'waiting' ? ' pn-tcard--waiting' : ''}`}>
            <div class="pn-pane__head">
              <div class="pn-pane__top">
                <PanelAgentIcon agent={s.agent} />
                <span class="pn-pane__title">{s.title}</span>
                <span class={`pn-pill pn-pill--${s.state}`}>{ui.states[s.state]}</span>
                <div class="pn-switch" role="group" aria-label={ui.viewLabel}>
                  <button type="button" data-view-btn="term" aria-pressed="true">
                    {ui.terminal}
                  </button>
                  <button type="button" data-view-btn="chat" aria-pressed="false">
                    {ui.chat}
                  </button>
                </div>
              </div>
              <div class="pn-meta">
                <span>{s.project}</span>
                <span>{s.branch}</span>
                <span class="pn-meta__model">{s.model}</span>
                <span>{s.time}</span>
                <span class="pn-ctx">
                  ctx
                  <span class="pn-ctx__bar">
                    <span style={`width:${s.ctx}%`} />
                  </span>
                  {s.ctx} %
                </span>
              </div>
            </div>

            <div class="pn-term">
              {s.lines.map((line) => (
                <div class={`pn-line pn-line--${line.tone}`}>{line.t}</div>
              ))}
              {panelSims[s.id] && <PanelWork sim={panelSims[s.id]!} variant="term" />}
              <div class="pn-prompt">&gt;</div>
            </div>

            <div class="pn-chat">
              {s.chat.map((msg) => (
                <div class={`pn-msg ${msg.me ? 'pn-msg--me' : ''}`}>
                  <span class="pn-msg__who">{msg.me ? ui.you : s.agent}</span>
                  <span class="pn-msg__text">{msg.t}</span>
                </div>
              ))}
              {panelSims[s.id] && <PanelWork sim={panelSims[s.id]!} variant="chat" />}
              <div class="pn-input">{ui.input}</div>
            </div>
            </div>

            <div class="pn-status">
              <span class="pn-status__tag">[jdev]</span>
              <span class="pn-status__tmux">{tmux(s.id)}</span>
              <span class="pn-status__alive">{ui.alive}</span>
            </div>
          </div>
        ))
      }
    </div>

    <PanelContext t={t} mapNames={mapNames} lang={lang} first={first} />
  </div>

  <div class="pn-screen pn-home" data-screen="inicio" hidden>
    <div class="pn-home__main">
      <div class="pn-home__head">
        <div>
          <span class="pn-home__shift">{home.shift}</span>
          <p class="pn-home__greeting">
            <span class="pn-greet-on">{home.greeting}</span>
            <span class="pn-greet-off">{ui.nav[0].label}</span>
          </p>
          <span class="pn-home__summary">{home.summary}</span>
        </div>
        <div class="pn-home__chips">
          {home.chips.map((chip) => <span class={`pn-pill pn-pill--${chip.state}`}>{chip.text}</span>)}
        </div>
      </div>

      <p class="pn-home__label">{home.attention}</p>
      <div class="pn-home__items">
        {
          home.items.map((item) => (
            <div
              class={`pn-item pn-item--${item.kind}`}
              data-proj={item.open ? projOfSession(item.open) : undefined}
              data-pending-item={item.kind === 'pending' ? '' : undefined}
            >
              <span class="pn-item__mark" aria-hidden="true">
                {item.kind === 'waiting' ? '●' : item.kind === 'done' ? '✓' : '□'}
              </span>
              <div class="pn-item__text">
                <span class="pn-item__title" data-one={item.one || undefined}>
                  {item.title}
                </span>
                <span>{item.text}</span>
              </div>
              <span class="pn-item__meta">{item.meta}</span>
              <button type="button" data-open={item.open || undefined} data-screen-btn={item.screen || undefined}>
                {item.action}
              </button>
            </div>
          ))
        }
      </div>

      <div class="pn-home__activity">
        <p class="pn-home__label">{home.activity}</p>
        <div class="pn-switch" role="group" aria-label={home.periodLabel}>
          {
            home.periods.map((period) => (
              <button type="button" data-period-btn={period.id} aria-pressed={period.id === 'week' ? 'true' : 'false'}>
                {period.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="pn-tiles">
        {
          home.tiles.map((tile) => (
            <div class="pn-tile">
              <span class="pn-tile__label">{tile.label}</span>
              {periods.map((id) => <span class={`pn-tile__value pn-p pn-p--${id}`}>{tile[id]}</span>)}
            </div>
          ))
        }
      </div>
      <div class="pn-charts">
        <div class="pn-tile">
          <span class="pn-tile__title">{home.heatTitle}</span>
          <div class="pn-heat" role="img" aria-label={home.heatLabel}>
            {heat.map((row) => row.map((level) => <span class={`pn-heat__cell pn-heat__cell--${level}`} />))}
          </div>
          <div class="pn-heat__legend" aria-hidden="true">
            {home.less}
            {[0, 1, 2, 3, 4].map((level) => <span class={`pn-heat__cell pn-heat__cell--${level}`} />)}
            {home.more}
          </div>
        </div>
        <div class="pn-tile">
          <span class="pn-tile__title">{home.byProject}</span>
          <div class="pn-bars">
            {
              home.bars.map((bar) => (
                <div class="pn-bar">
                  <span class="pn-mono" style={`background:${colorOf(bar.project)}`}>
                    {monoOf(bar.project)}
                  </span>
                  <span class="pn-bar__name">{bar.project}</span>
                  <span class="pn-bar__track">
                    {periods.map((id) => <span class={`pn-p pn-p--${id}`} style={`width:${bar[id][1]}%`} />)}
                  </span>
                  {periods.map((id) => <span class={`pn-bar__value pn-p pn-p--${id}`}>{bar[id][0]}</span>)}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="pn-home__aside">
      <p class="pn-home__label">{home.recent}</p>
      <ul class="pn-recent">
        {
          home.entries.map((entry) => (
            <li>
              <span class="pn-recent__meta">
                {entry.when} · {entry.project} <span class={`pn-recent__state pn-recent__state--${entry.tone}`}>{entry.state}</span>
              </span>
              <span>{entry.title}</span>
            </li>
          ))
        }
      </ul>
      <button type="button" class="pn-home__more" data-screen-btn="historial">{home.allHistory}</button>
    </div>
  </div>

  <PanelProjects lang={lang} projects={projects} empty={ui.noProjects} action={ui.noProjectsAction} />
  <PanelHistory lang={lang} />
  <PanelSettings lang={lang} projects={projects} />
</div>

<script>
  import { setupPanelSims } from '../scripts/panelSim';

  // Sin dependencias: el estado vive en atributos y el HTML ya trae todas las sesiones.
  for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
    const all = <T extends HTMLElement>(sel: string) => [...panel.querySelectorAll<T>(sel)];

    const visible = (el: HTMLElement) => el.offsetParent !== null;
    const hiddenProject = (index: string | undefined) => index !== undefined && !panel.hasAttribute(`data-on-vis${index}`);

    // El mapa del panel derecho solo se anima con la pantalla Terminales a la vista, su sesión elegida, la pestaña visible
    // y el panel en pantalla. Fuera de eso se pausan las animaciones SMIL de todos los mapas y se detiene el bucle de la
    // simulación (mapa y línea de trabajo del terminal de la sesión que trabaja), que al volver sigue donde se quedó.
    const sims = setupPanelSims(panel);
    let inView = false;
    const syncMaps = () => {
      const on = inView && document.visibilityState === 'visible';
      // Un bloque dentro de algo oculto (otra pantalla, otra sesión, proyecto oculto) no tiene cajas.
      for (const sim of sims) sim.run(on && sim.el.getClientRects().length > 0);
      for (const svg of panel.querySelectorAll<SVGSVGElement>('.pn-context svg.mp')) {
        // Un SVG dentro de algo oculto no tiene cajas.
        if (on && svg.getClientRects().length > 0) svg.unpauseAnimations();
        else svg.pauseAnimations();
      }
    };

    const showScreen = (id: string) => {
      for (const screen of all('[data-screen]')) screen.hidden = screen.dataset.screen !== id;
      for (const btn of all('.pn-nav [data-screen-btn]')) {
        btn.setAttribute('aria-pressed', String(btn.dataset.screenBtn === id));
      }
      syncMaps();
    };

    const pick = (id: string) => {
      showScreen('terminales');
      for (const pane of all('[data-pane]')) pane.hidden = pane.dataset.pane !== id;
      for (const block of all('[data-ctx]')) block.hidden = block.dataset.ctx !== id;
      panel.querySelector('.pn-context__scroll')?.scrollTo(0, 0);
      for (const btn of all('[data-pick]')) {
        const selected = btn.dataset.pick === id;
        btn.setAttribute('aria-pressed', String(selected));
        // Una sesión hecha no tiene pestaña salvo mientras está abierta.
        if (btn.dataset.tabDone !== undefined) btn.hidden = !selected;
        // En pantallas estrechas la pestaña elegida puede quedar fuera de la tira: se desplaza solo lo justo.
        const strip = btn.parentElement;
        if (selected && btn.classList.contains('pn-tab') && strip) {
          if (btn.offsetLeft < strip.scrollLeft) strip.scrollLeft = btn.offsetLeft;
          else if (btn.offsetLeft + btn.offsetWidth > strip.scrollLeft + strip.clientWidth) {
            strip.scrollLeft = btn.offsetLeft + btn.offsetWidth - strip.clientWidth;
          }
        }
      }
      syncMaps();
    };

    const setView = (view: string) => {
      panel.dataset.view = view;
      for (const btn of all('[data-view-btn]')) {
        btn.setAttribute('aria-pressed', String(btn.dataset.viewBtn === view));
      }
    };

    const setPeriod = (period: string) => {
      panel.dataset.period = period;
      for (const btn of all('[data-period-btn]')) {
        btn.setAttribute('aria-pressed', String(btn.dataset.periodBtn === period));
      }
    };

    // data-set="grupo:valor": marca ese botón dentro de su grupo y muestra los
    // elementos data-when del mismo grupo. Sirve para listas con lector, pestañas y opciones.
    const applySet = (pair: string) => {
      const group = pair.split(':')[0];
      for (const btn of all(`[data-set^="${group}:"]`)) btn.setAttribute('aria-pressed', String(btn.dataset.set === pair));
      for (const el of all(`[data-when^="${group}:"]`)) el.hidden = el.dataset.when !== pair;
      panel.setAttribute(`data-g-${group}`, pair.slice(group.length + 1));
    };

    // Proyectos ocultos desde Ajustes: recuenta, y si lo que estaba abierto ya no
    // se ve, pasa al primero visible o muestra el estado vacío.
    const syncProjects = () => {
      const rows = all('.pn-side [data-pick]').filter((row) => !hiddenProject(row.dataset.proj));
      const count = panel.querySelector('[data-proj-count]');
      if (count) count.textContent = String(all('.pn-side .pn-project').filter((el) => !hiddenProject(el.dataset.proj)).length);
      panel.toggleAttribute('data-no-projects', rows.length === 0);
      const current = all('[data-pane]').find((pane) => !pane.hidden);
      if (rows.length && hiddenProject(current?.dataset.proj)) {
        const screen = all('[data-screen]').find((el) => !el.hidden)?.dataset.screen;
        pick(rows[0].dataset.pick!);
        if (screen) showScreen(screen);
      }
      const items = all('.pn-proj__item').filter((item) => !hiddenProject(item.dataset.proj));
      const selected = all('.pn-proj__item[aria-pressed="true"]')[0];
      if (items.length && hiddenProject(selected?.dataset.proj)) applySet(items[0].dataset.set!);
    };

    // Con el filtro activo, la entrada abierta debe estar en la lista; si no queda
    // ninguna con pendientes, lista y lector muestran que no hay nada.
    const syncHistory = () => {
      const filtering = panel.hasAttribute('data-on-only-pending');
      const entries = all('.pn-hentry[data-has-pending]');
      panel.toggleAttribute('data-no-pending', filtering && entries.length === 0);
      if (filtering && entries.length && !entries.some((entry) => entry.getAttribute('aria-pressed') === 'true')) {
        applySet(entries[0].dataset.set!);
      }
    };

    // Un pendiente marcado como hecho se refleja en la lista del historial y en el aviso de Inicio.
    const syncPending = () => {
      for (const article of all('.pn-hist article')) {
        const left = article.querySelectorAll('[data-todo]:not([data-done])').length;
        const entry = all(`.pn-hentry[data-set="${article.dataset.when}"]`)[0];
        if (!entry || left > 0) continue;
        entry.removeAttribute('data-has-pending');
        entry.querySelector('.pn-hentry__pending')?.setAttribute('hidden', '');
        const day = entry.closest<HTMLElement>('.pn-hist__day');
        if (day && !day.querySelector('.pn-hentry[data-has-pending]')) day.removeAttribute('data-has-pending');
      }
      const latest = panel.querySelectorAll('[data-latest-pending] [data-todo]:not([data-done])').length;
      const item = panel.querySelector<HTMLElement>('[data-pending-item]');
      const title = item?.querySelector<HTMLElement>('[data-one]');
      if (item && latest === 0) item.hidden = true;
      else if (title && latest === 1) title.textContent = title.dataset.one!;
      syncHistory();
    };

    // Con teclado, una pestaña a medio ver se desplaza dentro de su tira al recibir el foco.
    panel.addEventListener('focusin', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLElement>('.pn-tabs button, .pn-proj__tabs button, .pn-places button');
      const strip = btn?.parentElement;
      if (!btn || !strip) return;
      if (btn.offsetLeft < strip.scrollLeft) strip.scrollLeft = btn.offsetLeft;
      else if (btn.offsetLeft + btn.offsetWidth > strip.scrollLeft + strip.clientWidth) {
        strip.scrollLeft = btn.offsetLeft + btn.offsetWidth - strip.clientWidth;
      }
    });

    // Al cambiar de pantalla el panel cambia de alto: se anima para que la página no salte.
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    const animateHeight = (from: number) => {
      const to = panel.offsetHeight;
      if (calm.matches || Math.abs(to - from) < 2) return;
      panel.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: 260, easing: 'cubic-bezier(0.2, 0, 0, 1)' });
    };

    panel.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLElement>('button');
      if (!btn) return;
      const d = btn.dataset;
      const height = panel.offsetHeight;
      if (d.pick) pick(d.pick);
      if (d.open) pick(d.open);
      if (d.screenBtn) showScreen(d.screenBtn);
      if (d.viewBtn) setView(d.viewBtn);
      if (d.periodBtn) setPeriod(d.periodBtn);
      if (d.set) applySet(d.set);
      // data-goto abre una opción de otro grupo sin formar parte de él; admite varias separadas por espacios.
      if (d.goto) for (const pair of d.goto.split(' ')) applySet(pair);
      // Desplegables del panel derecho: «Actividad reciente» y «Sesión» se abren y cierran a la vez en todas las sesiones.
      if (d.collapse) {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        for (const toggle of all(`[data-collapse="${d.collapse}"]`)) {
          toggle.setAttribute('aria-expanded', String(open));
          const body = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
          if (body) body.hidden = !open;
        }
      }
      if (d.copy) {
        const label = btn.textContent;
        navigator.clipboard?.writeText(d.copy).then(
          () => {
            btn.textContent = d.copied ?? label;
            window.setTimeout(() => (btn.textContent = label), 1600);
          },
          () => {
            // Sin permiso para el portapapeles: el comando sigue visible para copiarlo a mano.
          },
        );
      }
      // Interruptor: su estado queda también como atributo del panel para el CSS.
      if (d.toggle) {
        const on = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', String(on));
        panel.toggleAttribute(`data-on-${d.toggle}`, on);
      }
      if (d.toggle?.startsWith('vis')) syncProjects();
      // Con el filtro activo, la entrada abierta debe seguir estando en la lista.
      if (d.toggle === 'only-pending') syncHistory();
      if (d.markDone !== undefined) {
        btn.closest('[data-todo]')?.setAttribute('data-done', '');
        btn.hidden = true;
        syncPending();
      }
      // Si el botón pulsado ha dejado de verse, el foco pasa a lo que se acaba de abrir.
      if (!visible(btn)) {
        const next =
          (d.markDone !== undefined && all('[data-mark-done]').find(visible)) ||
          all('.pn-hist [data-set][aria-pressed="true"], .pn-side [data-pick][aria-pressed="true"]').find(visible) ||
          all('.pn-nav [aria-pressed="true"]')[0];
        next?.focus();
      }
      animateHeight(height);
      syncMaps();
    });

    document.addEventListener('visibilitychange', syncMaps);
    window.addEventListener('resize', syncMaps);
    new IntersectionObserver((entries) => {
      inView = entries.some((entry) => entry.isIntersecting);
      syncMaps();
    }).observe(panel);
  }
</script>
