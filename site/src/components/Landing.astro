---
import '../styles/global.css';
import Panel from './Panel.astro';
import { es } from '../i18n/es';
import { en } from '../i18n/en';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = lang === 'es' ? es : en;

const repo = 'https://github.com/Jgonaz/jdev-ai';
const home = { es: '/', en: '/en/' };
const canonical = new URL(home[lang], Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f1113" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(home.es, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(home.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(home.es, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Las fuentes del panel (interfaz, logo y terminal) e IBM Plex Sans para los titulares. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@600&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Martian+Mono:wght@600;800&display=swap"
    />
  </head>
  <body>
    <div class="wrap">
      <header class="masthead">
        <a class="masthead__brand" href={home[lang]}>jdev-ai<i class="caret" aria-hidden="true"></i></a>
        <div class="masthead__links">
          <div class="lang" role="group" aria-label={t.header.language}>
            <a href={home.es} hreflang="es" lang="es" aria-label="Español" aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
            <a href={home.en} hreflang="en" lang="en" aria-label="English" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          </div>
          <a href={repo}>github.com/Jgonaz/jdev-ai</a>
        </div>
      </header>

      <main>
        <section class="open">
          <h1>{t.open.title}</h1>
          <p class="open__lead">{t.open.lead}</p>
          <div class="open__side">
            <pre class="code" tabindex="0"><span class="p">$</span> git clone {repo}.git</pre>
            <div class="open__meta">
              <a class="link" href="#start">{t.open.steps}</a>
              <span>{t.open.badge}</span>
            </div>
          </div>
        </section>

        <section id="panel" class="section section--wide">
          <div class="panel-intro">
            <h2>{t.panel.title}</h2>
            <p set:html={t.panel.lead} />
          </div>
          <Panel t={t.panel} lang={lang} />
          <p class="note">{t.panel.note}</p>
        </section>

        <section id="how" class="section">
          <p class="rail">{t.how.rail}</p>
          <div class="section__body">
            <div class="section__head">
              <h2>{t.how.title}</h2>
              <p>{t.how.lead}</p>
            </div>
            <ol class="steps">
              {
                t.how.steps.map((step) => (
                  <li class="step">
                    <div class="step__text">
                      <h3>{step.title}</h3>
                      <p>{step.text}</p>
                      {step.stop && <span class="stop">{t.how.stop}</span>}
                    </div>
                    <blockquote>
                      <p>{step.quote}</p>
                      <a class="link" href={`${repo}/blob/main/${step.file}`}>
                        {step.file}
                      </a>
                    </blockquote>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        <section id="subagents" class="section">
          <p class="rail">{t.sub.rail}</p>
          <div class="section__body">
            <div class="section__head">
              <h2>{t.sub.title}</h2>
              <p>{t.sub.lead}</p>
            </div>
            <div class="table-box" tabindex="0">
              <table>
                <thead>
                  <tr>
                    {t.sub.columns.map((column) => <th scope="col">{column}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {
                    t.sub.rows.map((row) => (
                      <tr>
                        <th scope="row">{row.name}</th>
                        <td>{row.model}</td>
                        <td class={row.writes ? 'yes' : 'no'}>{row.writes ? t.sub.yes : t.sub.no}</td>
                        <td>{row.role}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="repo" class="section">
          <p class="rail">{t.repo.rail}</p>
          <div class="section__body">
            <h2>{t.repo.title}</h2>
            <dl class="tree">
              {
                t.repo.tree.map((entry) => (
                  <div>
                    <dt>{entry.name}</dt>
                    <dd>{entry.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>

        <section id="limits" class="section">
          <p class="rail">{t.limits.rail}</p>
          <div class="section__body">
            <h2>{t.limits.title}</h2>
            <ul class="limits">
              {
                t.limits.items.map((item) => (
                  <li>
                    <strong>{item.strong}</strong> {item.text}
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <section id="start" class="section">
          <p class="rail">{t.start.rail}</p>
          <div class="section__body">
            <div class="section__head">
              <h2>{t.start.title}</h2>
              <p set:html={t.start.lead} />
            </div>
            <ol class="start">
              <li>
                <span>1. <Fragment set:html={t.start.steps[0]} /></span>
                <pre class="code" tabindex="0"><span class="p">$</span> git clone {repo}.git
<span class="p">$</span> cd jdev-ai
<span class="p">$</span> git clone {t.start.repoPlaceholder} projects/{t.start.project}</pre>
              </li>
              <li>
                <span>2. <Fragment set:html={t.start.steps[1]} /></span>
              </li>
              <li>
                <span>3. <Fragment set:html={t.start.steps[2]} /></span>
                <pre class="code" tabindex="0"><span class="p">$</span> bin/agent {t.start.project}
<span class="p">$</span> bin/agent {t.start.project} --codex</pre>
              </li>
            </ol>
            <a class="link" href={t.start.docsUrl}>{t.start.docs}</a>
          </div>
        </section>
      </main>

      <footer class="footer">
        <p>
          {t.footer.by} <a class="link" href="https://jgonaz.dev">Jorge González Azpillaga</a>.
        </p>
        <p class="footer__links">
          <a class="link" href={`${repo}/blob/main/LICENSE`}>{t.footer.license}</a>
          {
            lang === 'es' ? (
              <a class="link" href={home.en} hreflang="en" lang="en">
                English
              </a>
            ) : (
              <a class="link" href={home.es} hreflang="es" lang="es">
                Español
              </a>
            )
          }
        </p>
      </footer>
    </div>
  </body>
</html>
