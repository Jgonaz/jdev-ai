    "@xterm/xterm": "^6.0.0",
    "marked": "^18.1.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "node-gyp": "^13.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
