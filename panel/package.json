{
  "name": "jdev-ai-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panel gráfico local de Jdev-ai",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/main.ts",
